---
import Icon, { type IconName } from './Icon.astro';
import { t, tr, href, formatVnd, type Lang } from '../../i18n';
import { lines } from '../../lib/public';
import type { schema } from '../../db';

// compact (trang chủ, trang từng môn): bỏ danh sách quyền lợi + nhãn → thẻ thấp, trang ngắn lại trên điện thoại; đủ chi tiết ở /hoc-phi.
interface Props { plan: typeof schema.feePlans.$inferSelect; lang: Lang; i?: number; compact?: boolean }
const { plan: p, lang, i = 0, compact = false } = Astro.props;
// Icon theo thứ tự gói như poster của CLB.
const icons: IconName[] = ['crown', 'shield', 'child', 'graduation'];
const icon = icons[(p.sort - 1) % icons.length] ?? 'star';
---
<article data-tilt class:list={['@container reveal relative flex flex-col border-2', compact ? 'p-5 sm:p-6' : 'p-6 sm:p-8', ' hover:-translate-y-1.5 hover:shadow-[0_20px_50px_-20px_rgb(225_6_0/0.45)]',
  p.isFeatured ? 'premium-glow' : 'border-white/15 bg-coal']} style={`--i:${i}`}>
  <p class:list={['absolute -top-4 left-6 px-4 py-1 font-display text-lg uppercase tracking-widest', p.isFeatured ? 'bg-glory text-white' : 'bg-white text-ink']}>
    {tr(p, 'name', lang)}
  </p>
  {!compact && <Icon name={icon} class="mt-4 size-10 text-white" />}
  <!-- Chiều cao cố định trên màn rộng để giá các gói thẳng hàng. -->
  <div class:list={[!compact && 'lg:min-h-[7.25rem]']}>
    <h3 class:list={['mt-4', compact ? 'text-2xl' : 'text-3xl']}>{tr(p, 'headline', lang)}</h3>
    {p.condition && <p class="mt-1 text-sm text-ash">{tr(p, 'condition', lang)}</p>}
  </div>
  <div class:list={['border-t border-white/15', compact ? 'mt-4 pt-4' : 'mt-6 pt-6']}>
    <!-- Giá luôn 1 dòng: cỡ chữ theo bề ngang thẻ (24cqi ≈ "1.500.000" vừa khít), tối đa 60px. 4 thẻ/hàng thì thẻ hẹp → chữ nhỏ lại thay vì rớt "0". -->
    <p class="whitespace-nowrap font-display text-[clamp(2.25rem,24cqi,3.75rem)] leading-none tabular-nums" data-count={p.pricePerMonth}>{formatVnd(p.pricePerMonth)}</p>
    <p class="mt-1 font-display text-glory-bright tracking-wider">{t(lang, 'per_month')}</p>
  </div>
  {!compact && <ul class="mt-6 space-y-3 flex-1">
    {lines(tr(p, 'features', lang)).map((f) => (
      <li class="flex gap-3 text-white/85"><Icon name="check" class="size-5 shrink-0 mt-0.5 text-glory" />{f}</li>
    ))}
  </ul>}
  {compact && <div class="flex-1"></div>}
  {!compact && p.badge && (
    <p class="mt-8 flex items-center justify-center gap-3 bg-white text-ink font-display tracking-widest py-2">
      <Icon name="star" filled class="size-4 text-glory" />{p.badge}<Icon name="star" filled class="size-4 text-glory" />
    </p>
  )}
  <!-- Đăng ký học thử với gói này: form chọn sẵn gói (?goi=), CLB thấy ngay khách quan tâm gói nào. -->
  <a href={`${href('/dang-ky-hoc-thu', lang)}?goi=${p.id}`} class:list={['mt-4 w-full !text-base', p.isFeatured ? 'btn-red' : 'btn-ghost']}>
    {t(lang, 'cta_trial')}<Icon name="arrow-right" class="size-5" />
  </a>
</article>
