---
import Icon from './Icon.astro';
import TestimonialAuthor from './TestimonialAuthor.astro';
import { t, tr, type Lang } from '../../i18n';
import type { schema } from '../../db';

// Scroll testimonials continuously without a visible jump at the end.
// Clone enough cards to fill the viewport, then wrap by one full cycle.
// Ease to a stop on hover, focus, dialog, or pause, then resume smoothly.
// Support drag, swipe, and arrow keys. Reduced motion uses manual scrolling.
type Item = typeof schema.testimonials.$inferSelect;
interface Props { items: Item[]; lang: Lang; tone?: 'coal' | 'ink' }
const { items, lang, tone = 'coal' } = Astro.props;
---
<div data-tm role="region" aria-roledescription="carousel" aria-label={t(lang, 'testimonials_title')}>
  <!-- Use container units for card widths because the strip uses max-content. -->
  <div data-tm-view class="@container overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_5%,#000_95%,transparent)] touch-pan-y select-none motion-reduce:overflow-x-auto motion-reduce:snap-x motion-reduce:snap-mandatory motion-reduce:[mask-image:none] motion-reduce:touch-auto motion-reduce:select-auto">
    <ul data-tm-track class="flex w-max items-start gap-5 px-4 pt-3 pb-8 will-change-transform sm:px-6 lg:gap-6 motion-reduce:will-change-auto">
      {items.map((x, i) => (
        <li class="flex w-[82cqi] shrink-0 snap-start sm:w-[44cqi] lg:w-[min(30rem,30cqi)]" aria-roledescription="slide" aria-label={`${i + 1} / ${items.length}`}>
          <figure class:list={['group/tm flex min-h-64 w-full flex-col border-l-4 border-glory p-6 transition-[border-color,translate,box-shadow] duration-300 ease-out hover:-translate-y-1.5 hover:border-white hover:shadow-[0_24px_50px_-24px_rgb(225_6_0/0.6)] sm:p-7', tone === 'coal' ? 'bg-coal' : 'bg-ink']}>
            <!-- Put the author above the quote so short cards do not leave a gap between them. -->
            <TestimonialAuthor item={x} lang={lang} large class="" />
            <Icon name="quote" filled class="mt-5 size-7 shrink-0 text-glory/40 transition-colors duration-300 group-hover/tm:text-glory" />
            <blockquote class="mt-2 line-clamp-5 whitespace-pre-line break-words text-lg text-white/90">{tr(x, 'content', lang)}</blockquote>
            <!-- Show Read more only when text is actually clipped. -->
            <button type="button" data-tm-more hidden class="mt-2 min-h-11 items-center gap-1 self-start font-display text-sm uppercase tracking-wider text-glory-bright hover:text-white [&:not([hidden])]:inline-flex">
              {t(lang, 'read_more')}<Icon name="arrow-right" class="size-4" />
            </button>
          </figure>
        </li>
      ))}
    </ul>
  </div>

  <!-- Show the active card, progress, pause, and navigation controls. -->
  <div class="container-x mt-6 flex items-center gap-4">
    <p class="shrink-0 font-display text-lg tracking-wider text-white/85 tabular-nums"><span data-tm-pos>1</span><span class="text-ash"> / {items.length}</span></p>
    <div class="h-0.5 flex-1 overflow-hidden bg-white/10" aria-hidden="true"><div data-tm-bar class="h-full origin-left scale-x-0 bg-glory"></div></div>
    <button type="button" data-tm-toggle aria-pressed="false" aria-label={t(lang, 'testimonials_pause')} data-pause={t(lang, 'testimonials_pause')} data-play={t(lang, 'testimonials_play')}
      class="group grid size-12 shrink-0 place-items-center border-2 border-white/20 text-white/85 transition-colors hover:border-white hover:text-white motion-reduce:hidden">
      <Icon name="pause" filled class="size-4 group-aria-pressed:hidden" />
      <Icon name="play" filled class="hidden size-4 group-aria-pressed:block" />
    </button>
    <button type="button" data-tm-go="-1" aria-label={t(lang, 'prev')} class="grid size-12 shrink-0 place-items-center border-2 border-white/20 transition-colors hover:border-glory hover:bg-glory active:scale-95"><Icon name="chevron-left" /></button>
    <button type="button" data-tm-go="1" aria-label={t(lang, 'next')} class="grid size-12 shrink-0 place-items-center border-2 border-white/20 transition-colors hover:border-glory hover:bg-glory active:scale-95"><Icon name="chevron-right" /></button>
  </div>

  <dialog data-tm-dialog class="m-auto w-[min(40rem,calc(100vw-2rem))] max-h-[85dvh] overflow-y-auto bg-coal p-0 text-white backdrop:bg-black/80" aria-label={t(lang, 'testimonials_title')}>
    <div data-tm-body></div>
    <form method="dialog" class="sticky bottom-0 flex justify-end border-t border-white/10 bg-coal p-3">
      <button class="btn-ghost !min-h-11 !text-base"><Icon name="x" />{t(lang, 'close')}</button>
    </form>
  </dialog>
</div>

<style>
  [data-tm-body] figure { border: 0; translate: none; box-shadow: none; }
</style>

<script>
  const SECONDS_PER_CARD = 4.5; // Time for one card to pass.

  document.querySelectorAll<HTMLElement>('[data-tm]').forEach((root) => {
    const view = root.querySelector<HTMLElement>('[data-tm-view]')!;
    const track = root.querySelector<HTMLElement>('[data-tm-track]')!;
    const originals = [...track.children] as HTMLElement[];
    const n = originals.length;
    const pos = root.querySelector<HTMLElement>('[data-tm-pos]')!;
    const bar = root.querySelector<HTMLElement>('[data-tm-bar]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-tm-toggle]')!;
    const dlg = root.querySelector<HTMLDialogElement>('[data-tm-dialog]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Open the full quote from originals and cloned cards.
    const markMore = () => track.querySelectorAll<HTMLButtonElement>('[data-tm-more]').forEach((b) => {
      const q = b.closest('figure')!.querySelector('blockquote')!;
      b.hidden = q.scrollHeight <= q.clientHeight + 1;
    });
    let dragged = false;
    track.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('[data-tm-more]');
      if (!b || dragged) return;
      const fig = b.closest('figure')!.cloneNode(true) as HTMLElement;
      fig.querySelector('[data-tm-more]')?.remove();
      fig.querySelector('blockquote')?.classList.remove('line-clamp-5');
      dlg.querySelector('[data-tm-body]')!.replaceChildren(fig);
      dlg.showModal();
    });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); }); // Close when clicking the backdrop.

    const stepOf = () => (n > 1 ? originals[1].offsetLeft - originals[0].offsetLeft : originals[0].offsetWidth + parseFloat(getComputedStyle(track).columnGap));
    const setPos = (i: number) => { pos.textContent = String(((i % n) + n) % n + 1); };

    // Reduced motion uses manual scrolling without cloned cards.
    if (reduced) {
      markMore();
      root.querySelectorAll<HTMLButtonElement>('[data-tm-go]').forEach((b) => b.addEventListener('click', () => view.scrollBy({ left: Number(b.dataset.tmGo) * stepOf() })));
      view.addEventListener('scroll', () => {
        setPos(Math.round(view.scrollLeft / stepOf()));
        bar.style.scale = `${(view.scrollLeft + view.clientWidth) / view.scrollWidth} 1`;
      }, { passive: true });
      bar.style.scale = `${Math.min(1, view.clientWidth / view.scrollWidth)} 1`;
      return;
    }

    // Clone enough cards to cover the viewport plus one full cycle.
    let step = 0; // Distance between neighboring cards in pixels, measured on resize.
    let loop = 0; // Length of one complete cycle, including gaps.
    const build = () => {
      track.querySelectorAll('[data-tm-clone]').forEach((c) => c.remove());
      step = stepOf();
      loop = step * n;
      const sets = Math.max(1, Math.ceil(view.clientWidth / loop)) + 1;
      for (let s = 0; s < sets; s++) for (const li of originals) {
        const c = li.cloneNode(true) as HTMLElement;
        c.dataset.tmClone = '';
        c.setAttribute('aria-hidden', 'true');
        c.querySelectorAll('button').forEach((b) => { b.tabIndex = -1; });
        track.appendChild(c);
      }
      markMore();
    };

    let offset = 0; // Distance traveled within the current cycle.
    let rate = 1; // One is full speed and zero is stopped. Ease between them.
    let push = 0; // Remaining eased movement from the arrow controls.
    let fling = 0; // Release velocity in pixels per second.
    let paused = false, hovering = false, dragging = false, onScreen = false, raf = 0, last = 0;
    const wantRun = () => !paused && !hovering && !dragging && !dlg.open && !root.matches(':focus-within') && !document.hidden;

    const render = () => {
      offset = ((offset % loop) + loop) % loop;
      track.style.translate = `${-offset}px 0`;
      setPos(Math.floor(offset / step + 0.5));
      bar.style.scale = `${offset / loop} 1`;
    };
    const frame = (t: number) => {
      const dt = Math.min(0.05, (t - last) / 1000 || 0);
      last = t;
      rate += ((wantRun() ? 1 : 0) - rate) * (1 - Math.exp(-dt * 3)); // Ease speed changes over about one second.
      const pushNow = push * (1 - Math.exp(-dt * 7));
      push -= pushNow;
      fling *= Math.exp(-dt * 3.5);
      if (!dragging) offset += (step / SECONDS_PER_CARD) * rate * dt + pushNow + fling * dt;
      render();
      raf = onScreen ? requestAnimationFrame(frame) : 0;
    };
    const wake = () => { if (!raf && onScreen) { last = performance.now(); raf = requestAnimationFrame(frame); } };

    // Animate only while the strip is visible.
    new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; wake(); }).observe(root);
    root.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hovering = true; });
    root.addEventListener('pointerleave', () => { hovering = false; });
    root.querySelectorAll<HTMLButtonElement>('[data-tm-go]').forEach((b) => b.addEventListener('click', () => { push += Number(b.dataset.tmGo) * step; wake(); }));
    toggle.addEventListener('click', () => {
      paused = !paused;
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.setAttribute('aria-label', (paused ? toggle.dataset.play : toggle.dataset.pause) ?? '');
    });

    // Follow drag or swipe movement and preserve vertical page scrolling.
    let startX = 0, lastX = 0, lastT = 0, vel = 0, pid = -1;
    view.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      pid = e.pointerId; startX = lastX = e.clientX; lastT = e.timeStamp; vel = 0; dragged = false; fling = 0; push = 0;
    });
    view.addEventListener('pointermove', (e) => {
      if (e.pointerId !== pid) return;
      const dx = e.clientX - lastX;
      if (!dragging && Math.abs(e.clientX - startX) > 6) { dragging = dragged = true; view.setPointerCapture(pid); }
      if (!dragging) return;
      offset -= dx;
      vel = (-dx / Math.max(1, e.timeStamp - lastT)) * 1000;
      lastX = e.clientX; lastT = e.timeStamp;
      render();
    });
    const end = (e: PointerEvent) => {
      if (e.pointerId !== pid) return;
      pid = -1;
      if (dragging) { dragging = false; fling = Math.max(-4000, Math.min(4000, vel)); }
      setTimeout(() => { dragged = false; }, 0); // Suppress the click immediately after a drag.
    };
    view.addEventListener('pointerup', end);
    view.addEventListener('pointercancel', end);

    // Rebuild clones on resize and preserve relative position.
    let w = view.clientWidth;
    new ResizeObserver(() => {
      if (Math.abs(view.clientWidth - w) < 2) return;
      w = view.clientWidth;
      const ratio = loop ? offset / loop : 0;
      build();
      offset = ratio * loop;
      render();
    }).observe(view);
    document.addEventListener('visibilitychange', wake);

    build();
    render();
  });
</script>
