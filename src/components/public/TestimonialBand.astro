---
import Icon from './Icon.astro';
import TestimonialAuthor from './TestimonialAuthor.astro';
import { t, tr, type Lang } from '../../i18n';
import type { schema } from '../../db';

// Cảm nhận dạng băng chuyền (trang chủ + /cam-nhan): tối đa 3 thẻ một lúc (máy tính), 2 (máy tính bảng), 1 thẻ + mép thẻ sau (điện thoại).
// Trượt mượt từng thẻ mỗi 5 giây, hết thì quay về đầu; mũi tên ← →, vuốt được trên điện thoại (scroll-snap có sẵn của trình duyệt).
// Đứng yên khi: rê chuột, focus bằng phím, bấm Dừng, đang đọc "Đọc tiếp", khối không nằm trên màn hình, người dùng tắt hiệu ứng.
type Item = typeof schema.testimonials.$inferSelect;
interface Props { items: Item[]; lang: Lang; tone?: 'coal' | 'ink' }
const { items, lang, tone = 'coal' } = Astro.props;
---
<div class="container-x" data-tm role="region" aria-roledescription="carousel" aria-label={t(lang, 'testimonials_title')}>
  <!-- items-start: mỗi thẻ cao theo nội dung (không kéo theo thẻ dài nhất cả dải → thẻ ngắn trống trơn). -->
  <ul data-tm-track class="-mx-4 flex items-start snap-x snap-mandatory scroll-px-4 gap-5 overflow-x-auto scroll-smooth px-4 pb-1 [scrollbar-width:none] motion-reduce:scroll-auto sm:mx-0 sm:scroll-px-0 sm:px-0 lg:gap-6 [&::-webkit-scrollbar]:hidden">
    {items.map((x, i) => (
      <li class="flex w-[85%] shrink-0 snap-start sm:w-[calc((100%-1.25rem)/2)] lg:w-[calc((100%-3rem)/3)]" aria-roledescription="slide" aria-label={`${i + 1} / ${items.length}`}>
        <figure class:list={['flex min-h-64 w-full flex-col border-l-4 border-glory p-6 transition-colors duration-200 hover:border-white sm:p-7', tone === 'coal' ? 'bg-coal' : 'bg-ink']}>
          <!-- Gương mặt trước, lời nói sau: thẻ ngắn không bị khoảng trống giữa lời và tên. -->
          <TestimonialAuthor item={x} lang={lang} large class="" />
          <Icon name="quote" filled class="mt-5 size-7 shrink-0 text-glory/40" />
          <blockquote class="mt-2 line-clamp-5 whitespace-pre-line break-words text-lg text-white/90">{tr(x, 'content', lang)}</blockquote>
          <!-- Chỉ hiện khi chữ thật sự bị cắt (script đo), kể cả cảm nhận ngắn mà nhiều dòng. -->
          <button type="button" data-tm-more hidden class="mt-2 min-h-11 items-center gap-1 self-start font-display text-sm uppercase tracking-wider text-glory-bright hover:text-white [&:not([hidden])]:inline-flex">
            {t(lang, 'read_more')}<Icon name="arrow-right" class="size-4" />
          </button>
        </figure>
      </li>
    ))}
  </ul>

  <!-- Thanh điều khiển: vị trí + vạch tiến độ + Dừng + ← →. Ẩn khi mọi thẻ đã vừa màn hình. -->
  <div data-tm-ctrl class="mt-6 flex items-center gap-4">
    <p class="shrink-0 font-display text-lg tracking-wider text-white/85" aria-live="polite"><span data-tm-pos>1</span><span class="text-ash"> / {items.length}</span></p>
    <div class="h-0.5 flex-1 bg-white/10" aria-hidden="true"><div data-tm-bar class="h-full w-0 bg-glory transition-[width] duration-500 ease-out motion-reduce:transition-none"></div></div>
    <button type="button" data-tm-toggle aria-pressed="false" aria-label={t(lang, 'testimonials_pause')} data-pause={t(lang, 'testimonials_pause')} data-play={t(lang, 'testimonials_play')}
      class="group grid size-12 shrink-0 place-items-center border-2 border-white/20 text-white/85 transition-colors hover:border-white hover:text-white motion-reduce:hidden">
      <Icon name="pause" filled class="size-4 group-aria-pressed:hidden" />
      <Icon name="play" filled class="hidden size-4 group-aria-pressed:block" />
    </button>
    <button type="button" data-tm-go="-1" aria-label={t(lang, 'prev')} class="grid size-12 shrink-0 place-items-center border-2 border-white/20 transition-colors hover:border-glory hover:bg-glory active:scale-95"><Icon name="chevron-left" /></button>
    <button type="button" data-tm-go="1" aria-label={t(lang, 'next')} class="grid size-12 shrink-0 place-items-center border-2 border-white/20 transition-colors hover:border-glory hover:bg-glory active:scale-95"><Icon name="chevron-right" /></button>
  </div>

  <dialog data-tm-dialog class="m-auto w-[min(40rem,calc(100vw-2rem))] max-h-[85dvh] overflow-y-auto bg-coal p-0 text-white backdrop:bg-black/80" aria-label={t(lang, 'testimonials_title')}>
    <div data-tm-body></div>
    <form method="dialog" class="sticky bottom-0 flex justify-end border-t border-white/10 bg-coal p-3">
      <button class="btn-ghost !min-h-11 !text-base"><Icon name="x" />{t(lang, 'close')}</button>
    </form>
  </dialog>
</div>

<style>
  [data-tm-body] figure { border: 0; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tm]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-tm-track]')!;
    const cards = [...track.children] as HTMLElement[];
    const ctrl = root.querySelector<HTMLElement>('[data-tm-ctrl]')!;
    const pos = root.querySelector<HTMLElement>('[data-tm-pos]')!;
    const bar = root.querySelector<HTMLElement>('[data-tm-bar]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-tm-toggle]')!;
    const dlg = root.querySelector<HTMLDialogElement>('[data-tm-dialog]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');

    // Một bước = khoảng cách giữa 2 thẻ liền nhau (thẻ + khe), đúng ở mọi cỡ màn hình.
    const step = () => (cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth);
    const atStart = () => track.scrollLeft <= 4;
    const atEnd = () => track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    const go = (dir: number) => {
      const behavior: ScrollBehavior = reduce.matches ? 'auto' : 'smooth';
      if (dir > 0 && atEnd()) track.scrollTo({ left: 0, behavior }); // hết thì quay về đầu
      else if (dir < 0 && atStart()) track.scrollTo({ left: track.scrollWidth, behavior });
      else track.scrollBy({ left: dir * step(), behavior });
    };
    const update = () => {
      ctrl.hidden = track.scrollWidth <= track.clientWidth + 4; // mọi thẻ đã vừa → không cần điều khiển
      const shown = Math.max(1, Math.round(track.clientWidth / step()));
      const first = atEnd() ? cards.length - shown : Math.round(track.scrollLeft / step());
      const last = Math.min(cards.length, first + shown);
      pos.textContent = shown > 1 ? `${first + 1}–${last}` : `${first + 1}`;
      bar.style.width = `${(last / cards.length) * 100}%`;
    };

    // Tự trượt: chỉ khi người xem không đang thao tác / đọc và khối đang nằm trên màn hình.
    let paused = false, hovering = false, onScreen = false, timer = 0;
    const running = () => !paused && !hovering && onScreen && !reduce.matches && !document.hidden && !ctrl.hidden && !dlg.open && !root.matches(':focus-within');
    const restart = () => { clearInterval(timer); timer = window.setInterval(() => running() && go(1), 5000); };
    root.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hovering = true; });
    root.addEventListener('pointerleave', () => { hovering = false; });
    new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; }, { threshold: 0.35 }).observe(root);

    root.querySelectorAll<HTMLButtonElement>('[data-tm-go]').forEach((b) => b.addEventListener('click', () => { go(Number(b.dataset.tmGo)); restart(); }));
    track.addEventListener('pointerdown', restart); // vừa vuốt tay thì đợi đủ 5 giây mới tự trượt tiếp
    track.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    toggle.addEventListener('click', () => {
      paused = !paused;
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.setAttribute('aria-label', (paused ? toggle.dataset.play : toggle.dataset.pause) ?? '');
    });

    // "Đọc tiếp": mở cảm nhận đầy đủ trong hộp thoại (bản sao của thẻ, bỏ giới hạn 5 dòng).
    root.querySelectorAll<HTMLButtonElement>('[data-tm-more]').forEach((b) => {
      const q = b.closest('figure')!.querySelector('blockquote')!;
      b.hidden = q.scrollHeight <= q.clientHeight + 1;
      b.addEventListener('click', () => {
        const fig = b.closest('figure')!.cloneNode(true) as HTMLElement;
        fig.querySelector('[data-tm-more]')?.remove();
        fig.querySelector('blockquote')?.classList.remove('line-clamp-5');
        dlg.querySelector('[data-tm-body]')!.replaceChildren(fig);
        dlg.showModal();
      });
    });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); }); // bấm ra ngoài để đóng

    update();
    restart();
  });
</script>
