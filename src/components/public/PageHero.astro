---
import Logo from '../Logo.astro';

// Đầu trang con: tiêu đề lớn, logo chìm, sọc đỏ chéo.
// slot "aside" (tuỳ chọn): khối bên phải trên máy tính, ngang hàng với tiêu đề (vd. thẻ "Hôm nay" ở Lịch học); điện thoại xếp dưới.
interface Props { eyebrow?: string; title: string; subtitle?: string }
const { eyebrow, title, subtitle } = Astro.props;
const aside = Astro.slots.has('aside');
---
<section class="relative isolate overflow-hidden border-b border-white/10 pt-16 pb-12 sm:pt-24 sm:pb-16">
  <Logo class="absolute -z-10 -right-16 -top-10 h-[140%] w-auto text-white/[0.035]" title="" />
  <div class="stripe-in absolute -z-10 left-0 bottom-0 h-3 w-1/2 sm:w-1/3 bg-glory -skew-x-[30deg] origin-bottom-left"></div>
  <div class="container-x">
    <div class:list={[aside && 'grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] lg:items-end lg:gap-16']}>
      <div class="min-w-0">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="text-5xl sm:text-7xl lg:text-8xl break-words">{title}</h1>
        {subtitle && <p class="mt-6 max-w-2xl text-lg text-white/75">{subtitle}</p>}
        <slot />
      </div>
      {aside && <div class="min-w-0"><slot name="aside" /></div>}
    </div>
  </div>
</section>
