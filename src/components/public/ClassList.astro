---
import Icon from './Icon.astro';
import { tr, t, dayShort, type Lang, type DictKey } from '../../i18n';
import type { PublicClass } from '../../lib/public';

// Compact schedule for discipline, coach, and home pages. Hide when empty.
interface Props {
  classes: PublicClass[];
  lang: Lang;
  locations: { id: number; name: string; nameEn: string | null }[];
  coaches?: { id: number; fullName: string }[];
  showDays?: boolean;
}
const { classes, lang, locations, coaches = [], showDays = true } = Astro.props;
const locName = (id: number) => { const l = locations.find((x) => x.id === id); return l ? tr(l, 'name', lang) : ''; };
const coachName = (id: number | null) => coaches.find((c) => c.id === id)?.fullName;
---
{classes.length > 0 && (
  <ul class="divide-y divide-white/10 border-y border-white/10">
    {classes.map((c) => (
      <li class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 py-4 sm:grid-cols-[9rem_8rem_1fr_auto] sm:items-center">
        {showDays && <span class="font-display text-xl tracking-wider text-glory-bright">{[...c.days].map((d) => dayShort(d, lang)).join(' · ')}</span>}
        <span class="flex items-center gap-1.5 font-display text-xl tracking-wide"><Icon name="clock" class="size-4 text-ash" />{c.startTime}–{c.endTime}</span>
        <span class="col-span-2 sm:col-span-1 font-semibold">
          {tr(c, 'name', lang)}{c.level !== 'all' && <span class="ml-2 inline-block bg-white px-1.5 py-0.5 align-middle font-display text-xs font-normal tracking-wider text-ink">{t(lang, `level_${c.level}` as DictKey)}</span>}
          {coachName(c.coachId) && <span class="text-ash font-normal"> · {t(lang, 'coach')} {coachName(c.coachId)}</span>}
          {tr(c, 'note', lang) && <span class="block text-sm font-normal text-white/70">{tr(c, 'note', lang)}</span>}
        </span>
        <span class="col-span-2 sm:col-span-1 flex items-center gap-1.5 text-sm text-ash"><Icon name="map-pin" class="size-4" />{locName(c.locationId)}</span>
      </li>
    ))}
  </ul>
)}
