---
import Logo from '../Logo.astro';
import Icon from './Icon.astro';
import { tr, href, t, formatDate, type Lang } from '../../i18n';
import { richText } from '../../lib/public';

// Bài kiểu Facebook: 1 ảnh = full, 2–4 ảnh = lưới, >4 = lưới 4 ô + "+N".
interface Props {
  post: { slug: string; title: string | null; titleEn: string | null; content: string; contentEn: string | null; publishedAt: number; images: string[] };
  lang: Lang;
  full?: boolean;
  i?: number;
}
const { post: p, lang, full = false, i = 0 } = Astro.props;
const title = tr(p, 'title', lang);
const body = tr(p, 'content', lang);
const shown = p.images.slice(0, 4);
const extra = p.images.length - shown.length;
const link = href(`/tin-tuc/${p.slug}`, lang);
---
<article class="reveal border border-white/10 bg-coal" style={`--i:${i}`}>
  <header class="flex items-center gap-3 p-4 sm:p-5">
    <span class="grid size-11 place-items-center bg-ink border border-white/15"><Logo class="h-7 w-auto text-white" title="" /></span>
    <div class="min-w-0">
      <p class="font-semibold leading-tight">Glory Fight Club</p>
      <p class="text-sm text-ash flex items-center gap-1.5"><Icon name="calendar" class="size-3.5" /><time datetime={new Date(p.publishedAt).toISOString()}>{formatDate(p.publishedAt, lang)}</time></p>
    </div>
  </header>
  <div class="px-4 sm:px-5 pb-4">
    {title && (full ? <h1 class="text-4xl sm:text-5xl">{title}</h1> : <h2 class="text-3xl"><a href={link} class="hover:text-glory transition-colors">{title}</a></h2>)}
    <div class:list={['mt-3 text-white/85', !full && 'line-clamp-4']} set:html={richText(body)} />
    {!full && <a href={link} class="mt-3 inline-flex items-center gap-1 font-display uppercase tracking-wider text-sm text-glory hover:text-white">{t(lang, 'read_more')}<Icon name="arrow-right" class="size-4" /></a>}
  </div>
  {shown.length > 0 && (
    full ? (
      <div class="grid gap-1 bg-ink">
        {p.images.map((k) => <img src={`/media/${k}`} alt="" loading="lazy" class="w-full h-auto" />)}
      </div>
    ) : (
      <a href={link} class:list={['grid gap-1 bg-ink', shown.length > 1 && 'grid-cols-2']} aria-label={title || t(lang, 'read_more')}>
        {shown.map((k, idx) => (
          <div class:list={['relative overflow-hidden', shown.length === 1 ? 'aspect-[4/3]' : 'aspect-square', shown.length === 3 && idx === 0 && 'row-span-2 !aspect-auto']}>
            <img src={`/media/${k}`} alt="" loading="lazy" class="absolute inset-0 size-full object-cover" />
            {idx === 3 && extra > 0 && <span class="absolute inset-0 grid place-items-center bg-ink/70 font-display text-5xl">+{extra}</span>}
          </div>
        ))}
      </a>
    )
  )}
</article>
