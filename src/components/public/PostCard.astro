---
import Icon from './Icon.astro';
import { tr, href, t, dayLong, type Lang } from '../../i18n';
import { richText, postHtml, youtubeEmbed, type PostMedia } from '../../lib/public';
import { toText } from '../../lib/html';
import { vnNow, youtubeId } from '../../lib/util';

// Một trang nhật ký lớp: ô ngày (như tờ lịch), chữ, ảnh / video / YouTube.
// Thẻ (trang chủ): đoạn trích + lưới 1–4 ô, ">4" hiện "+N". full (trang chi tiết): nội dung đủ, video phát được.
// compact (lưới trang Nhật ký): 1 ảnh bìa + "+N", trích 3 dòng — thẻ thấp, nhiều bài vẫn lướt nhanh.
interface Props {
  post: { slug: string; title: string | null; titleEn: string | null; content: string; contentEn: string | null; format: 'text' | 'html'; publishedAt: number; media: PostMedia[] };
  lang: Lang;
  full?: boolean;
  compact?: boolean;
  i?: number;
}
const { post: p, lang, full = false, compact = false, i = 0 } = Astro.props;
const title = tr(p, 'title', lang);
const body = tr(p, 'content', lang);
const excerpt = p.format === 'html' ? toText(body) : body;
const link = href(`/nhat-ky/${p.slug}`, lang);
const date = new Date(p.publishedAt);
const part = (o: Intl.DateTimeFormatOptions) => date.toLocaleString(lang === 'en' ? 'en-GB' : 'vi-VN', { timeZone: 'Asia/Ho_Chi_Minh', ...o });
const shown = p.media.slice(0, 4);
const extra = p.media.length - shown.length;
const src = (m: PostMedia) => `/media/${m.key}`;
const thumb = (m: PostMedia) => `/media/${m.key}?w=480`; // ô ảnh trên thẻ (trang chủ, danh sách) → bản 480px; trang bài dùng ảnh gốc
const ytThumb = (m: PostMedia) => `https://i.ytimg.com/vi/${youtubeId(m.key)}/hqdefault.jpg`;
const cover = p.media[0];
---
<!-- compact trên điện thoại: 1 hàng ngang (ảnh vuông bên trái) cho 12 bài vẫn ngắn; từ sm: thẻ đứng, ảnh bìa trên. -->
{compact ? (
  <article class="reveal group relative flex border border-white/10 bg-coal transition-colors duration-300 hover:border-glory sm:flex-col" style={`--i:${i}`}>
    {/* Bài chỉ có chữ: bìa thay thế (ngày to chữ viền) để lưới thẻ đều nhau. */}
    {!cover && (
      <div class="relative w-28 shrink-0 overflow-hidden bg-[radial-gradient(circle_at_80%_20%,#3a0d0b,#0a0a0a_70%)] sm:aspect-[16/10] sm:w-auto" aria-hidden="true">
        <span class="absolute -bottom-2 right-2 font-display text-6xl leading-none sm:-bottom-4 sm:right-3 sm:text-[7rem] text-outline-white transition-colors duration-300 group-hover:[-webkit-text-stroke-color:var(--color-glory)]">{part({ day: '2-digit' })}</span>
      </div>
    )}
    {cover && (
      <div class="relative min-h-28 w-28 shrink-0 overflow-hidden bg-ink sm:aspect-[16/10] sm:min-h-0 sm:w-auto">
        {cover.type === 'video'
          ? <video src={`${src(cover)}#t=0.1`} muted playsinline preload="metadata" class="absolute inset-0 size-full object-cover"></video>
          : <img src={cover.type === 'image' ? thumb(cover) : ytThumb(cover).replace('hqdefault', 'mqdefault')} alt="" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105" />}
        {cover.type !== 'image' && <span class="absolute inset-0 grid place-items-center" aria-hidden="true"><span class="grid size-9 place-items-center bg-glory/90 text-white sm:size-12"><Icon name="play" class="size-4 sm:size-5" /></span></span>}
        {p.media.length > 1 && <span class="absolute bottom-2 right-2 bg-ink/80 px-2 py-1 font-display text-sm tracking-wider text-white">+{p.media.length - 1}</span>}
      </div>
    )}
    <div class="flex min-w-0 flex-1 flex-col p-3 sm:p-5">
      <div class="flex items-center gap-3">
        <time datetime={date.toISOString()} class="hidden w-12 shrink-0 flex-col items-center bg-glory py-1 text-white sm:flex">
          <span class="font-display text-2xl leading-none">{part({ day: 'numeric' })}</span>
          <span class="text-xs font-semibold uppercase tracking-wider">{lang === 'en' ? part({ month: 'short' }) : `Th ${part({ month: 'numeric' })}`}</span>
        </time>
        <p class="text-xs font-semibold uppercase tracking-wider text-ash sm:text-sm">{dayLong(vnNow(date).weekday, lang)}<span class="sm:hidden"> · {part({ day: 'numeric', month: 'numeric' })}</span></p>
      </div>
      {title && <h3 class="mt-1 line-clamp-2 text-xl sm:mt-3 sm:line-clamp-none sm:text-2xl"><a href={link} class="after:absolute after:inset-0 hover:text-glory transition-colors">{title}</a></h3>}
      {excerpt && <p class="mt-1 line-clamp-2 whitespace-pre-line text-sm text-white/80 sm:mt-2 sm:line-clamp-3 sm:text-base" set:html={richText(excerpt)} />}
      <span class="mt-auto hidden min-h-11 items-center gap-1 pt-2 font-display sm:inline-flex text-sm uppercase tracking-wider text-glory-bright transition-[gap] group-hover:gap-2">{t(lang, 'read_more')}<Icon name="arrow-right" class="size-4" /></span>
      {!title && <a href={link} class="absolute inset-0" aria-label={t(lang, 'read_more')}></a>}
    </div>
  </article>
) : (
<article class="reveal border border-white/10 bg-coal" style={`--i:${i}`}>
  <header class="flex items-center gap-4 p-4 sm:p-5">
    <time datetime={date.toISOString()} class="flex w-16 shrink-0 flex-col items-center bg-glory py-2 text-white">
      <span class="font-display text-3xl leading-none">{part({ day: 'numeric' })}</span>
      <span class="mt-1 text-xs font-semibold uppercase tracking-wider">{lang === 'en' ? part({ month: 'short' }) : `Th ${part({ month: 'numeric' })}`}</span>
    </time>
    <div class="min-w-0">
      <p class="text-sm font-semibold uppercase tracking-wider text-ash">{dayLong(vnNow(date).weekday, lang)} · {part({ year: 'numeric' })}</p>
      {title && (full
        ? <h1 class="mt-1 text-4xl sm:text-5xl">{title}</h1>
        : <h3 class="mt-1 text-2xl sm:text-3xl"><a href={link} class="hover:text-glory transition-colors">{title}</a></h3>)}
    </div>
  </header>

  {(full ? body : excerpt) && (
    <div class="px-4 pb-4 sm:px-5">
      {full
        ? <div class="rich" set:html={postHtml(p, body)} />
        : <p class="line-clamp-4 whitespace-pre-line text-white/85" set:html={richText(excerpt)} />}
    </div>
  )}
  {!full && <a href={link} class="mx-4 mb-3 inline-flex min-h-11 items-center gap-1 font-display text-sm uppercase tracking-wider text-glory-bright hover:text-white sm:mx-5">{t(lang, 'read_more')}<Icon name="arrow-right" class="size-4" /></a>}

  {p.media.length > 0 && (full ? (
    <div class="grid gap-1 bg-ink">
      {p.media.map((m) => m.type === 'image'
        ? <a href={src(m)} data-lightbox="diary" data-caption={title}><img src={src(m)} alt={title || t(lang, 'news_title')} loading="lazy" decoding="async" class="h-auto w-full" /></a>
        : m.type === 'video'
          ? <video src={`${src(m)}#t=0.1`} controls playsinline preload="metadata" class="max-h-[85vh] w-full bg-black"></video>
          : <div class="aspect-video"><iframe src={youtubeEmbed(m.key)} title={title || t(lang, 'watch_video')} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen class="size-full"></iframe></div>)}
    </div>
  ) : (
    <a href={link} class:list={['grid gap-1 bg-ink', shown.length > 1 && 'grid-cols-2']} aria-label={title || t(lang, 'read_more')}>
      {shown.map((m, idx) => (
        <div class:list={['relative overflow-hidden', shown.length === 1 ? 'aspect-[4/3]' : 'aspect-square', shown.length === 3 && idx === 0 && 'row-span-2 !aspect-auto']}>
          {m.type === 'video'
            ? <video src={`${src(m)}#t=0.1`} muted playsinline preload="metadata" class="absolute inset-0 size-full object-cover"></video>
            : <img src={m.type === 'image' ? thumb(m) : ytThumb(m)} alt="" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />}
          {m.type !== 'image' && <span class="absolute inset-0 grid place-items-center" aria-hidden="true"><span class="grid size-14 place-items-center bg-glory/90 text-white"><Icon name="play" class="size-6" /></span></span>}
          {idx === 3 && extra > 0 && <span class="absolute inset-0 grid place-items-center bg-ink/70 font-display text-5xl">+{extra}</span>}
        </div>
      ))}
    </a>
  ))}
</article>
)}
