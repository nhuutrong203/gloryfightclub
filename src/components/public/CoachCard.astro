---
import Logo from '../Logo.astro';
import Icon from './Icon.astro';
import { tr, href, t as baseT, type Lang } from '../../i18n';
const t = (lang: Parameters<typeof baseT>[0], key: Parameters<typeof baseT>[1]) => baseT(lang, key, Astro.locals.site.texts);
import { thumbSrcset, thumbUrl } from '../../lib/site';
import { lines } from '../../lib/public';
import AchievementIcon from './AchievementIcon.astro';
import MedalTally from './MedalTally.astro';
import { extraAwards, tally } from '../../lib/medals';
import type { schema } from '../../db';

interface Props { coach: typeof schema.coaches.$inferSelect & { awards?: { title: string; titleEn: string | null; eventName: string | null; eventDate: string | null }[] }; lang: Lang; i?: number; tone?: 'light' | 'dark'; class?: string }
const { coach: c, lang, i = 0, tone = 'dark', class: className } = Astro.props;
// Combine written achievements with linked records and avoid counting the same medal twice.
const text = lines(tr(c, 'achievements', lang));
const achievements = [...text, ...extraAwards(text, c.awards ?? [], (a) => ({ title: tr(a, 'title', lang), event: a.eventName })).map((a) => tr(a, 'title', lang))];
const photo = thumbUrl(c.photoKey); // Use the 800px thumbnail with the original available via srcset.
const medals = tally(achievements);
const hasMedals = medals.gold + medals.silver + medals.bronze > 0;
// Show initials when no photo is available.
const initials = c.fullName.trim().split(/\s+/).slice(-2).map((w) => w[0]).join('');
---
<a href={href(`/huan-luyen-vien/${c.slug}`, lang)} class:list={['reveal group block', className]} style={`--i:${i}`}>
  <div class="relative aspect-[4/5] overflow-hidden bg-ink" data-tilt>
    {photo
      ? <img src={photo} srcset={thumbSrcset(c.photoKey)} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 320px, 64vw" alt={c.fullName} loading="lazy" class="size-full object-cover" data-zoom />
      : (
        <div class="relative size-full overflow-hidden bg-[radial-gradient(circle_at_70%_15%,#2b0d0c,#0a0a0a_65%)]">
          <Logo class="absolute -right-[18%] -top-[8%] h-[85%] w-auto text-white/[0.06] transition-transform duration-500 group-hover:scale-105" title="" />
          <span class="absolute bottom-3 left-4 font-display text-[clamp(4rem,22vw,8rem)] leading-none text-outline-white transition-colors duration-300 group-hover:[-webkit-text-stroke-color:var(--color-glory)]" aria-hidden="true">{initials}</span>
        </div>
      )}
    <div class="absolute inset-x-0 bottom-0 h-1.5 bg-glory origin-left scale-x-0 transition-transform duration-300 group-hover:scale-x-100"></div>
    {achievements.length > 0 && !hasMedals && (
      <span class="absolute top-4 left-4 flex items-center gap-1.5 bg-glory px-2.5 py-1 font-display text-sm tracking-wider text-white">
        <Icon name="trophy" class="size-4" />{achievements.length}
      </span>
    )}
  </div>
  <h3 class="mt-4 text-xl sm:text-3xl group-hover:text-glory transition-colors">{c.fullName}</h3>
  <p class:list={['mt-1 text-xs sm:text-sm font-semibold leading-snug', tone === 'light' ? 'text-glory-dark' : 'text-glory-bright']}>{tr(c, 'title', lang)}</p>
  <MedalTally lines={achievements} lang={lang} class="mt-3" />
  {achievements.length > 0 && (
    <ul class:list={['mt-3 space-y-1.5 text-xs sm:text-sm', tone === 'light' ? 'text-ink/80' : 'text-white/75']}>
      {achievements.slice(0, 3).map((a) => <li class="flex items-start gap-2"><AchievementIcon line={a} class="size-5" />{a}</li>)}
    </ul>
  )}
  <span class="mt-3 inline-flex min-h-11 items-center gap-1 font-display uppercase tracking-wider text-sm transition-[gap] duration-200 group-hover:gap-2">{t(lang, 'view_coach')}<Icon name="arrow-right" class="size-4" /></span>
</a>
