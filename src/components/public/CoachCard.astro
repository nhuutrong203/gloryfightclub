---
import Logo from '../Logo.astro';
import Icon from './Icon.astro';
import { tr, href, t, type Lang } from '../../i18n';
import { mediaUrl } from '../../lib/site';
import { lines } from '../../lib/public';
import type { schema } from '../../db';

interface Props { coach: typeof schema.coaches.$inferSelect; lang: Lang; i?: number; tone?: 'light' | 'dark'; class?: string }
const { coach: c, lang, i = 0, tone = 'dark', class: className } = Astro.props;
const achievements = lines(tr(c, 'achievements', lang));
const photo = mediaUrl(c.photoKey);
---
<a href={href(`/huan-luyen-vien/${c.slug}`, lang)} class:list={['reveal group block', className]} style={`--i:${i}`}>
  <div class="relative aspect-[3/4] overflow-hidden bg-ink">
    {photo
      ? <img src={photo} alt={c.fullName} loading="lazy" class="size-full object-cover grayscale contrast-125 transition duration-300 group-hover:grayscale-0 group-hover:scale-105" />
      : (
        <div class="size-full grid place-items-center bg-[radial-gradient(circle_at_30%_20%,#2a2a2a,#0a0a0a_70%)]">
          <Logo class="w-1/2 h-auto text-white/10" title="" />
          <span class="absolute bottom-6 left-6 font-display text-7xl text-outline-white leading-none" aria-hidden="true">{c.fullName.split(' ').at(-1)}</span>
        </div>
      )}
    <div class="absolute inset-x-0 bottom-0 h-1.5 bg-glory origin-left scale-x-0 transition-transform duration-300 group-hover:scale-x-100"></div>
    {achievements.length > 0 && (
      <span class="absolute top-4 left-4 flex items-center gap-1.5 bg-glory px-2.5 py-1 font-display text-sm tracking-wider text-white">
        <Icon name="trophy" class="size-4" />{achievements.length}
      </span>
    )}
  </div>
  <h3 class="mt-4 text-3xl group-hover:text-glory transition-colors">{c.fullName}</h3>
  <p class:list={['text-sm font-semibold', tone === 'light' ? 'text-glory-dark' : 'text-glory']}>{tr(c, 'title', lang)}</p>
  {achievements.length > 0 && (
    <ul class:list={['mt-3 space-y-1.5 text-sm', tone === 'light' ? 'text-ink/80' : 'text-white/75']}>
      {achievements.slice(0, 3).map((a) => <li class="flex gap-2"><Icon name="medal" class="size-4 shrink-0 mt-0.5" />{a}</li>)}
    </ul>
  )}
  <span class="mt-3 inline-flex items-center gap-1 font-display uppercase tracking-wider text-sm">{t(lang, 'view_coach')}<Icon name="arrow-right" class="size-4" /></span>
</a>
