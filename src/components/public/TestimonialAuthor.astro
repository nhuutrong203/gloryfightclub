---
import { thumbUrl } from '../../lib/site';
import { tr, type Lang } from '../../i18n';
import type { schema } from '../../db';

// Show an author photo or initials in testimonial cards.
// The testimonial band gives the author photo more space.
interface Props { item: typeof schema.testimonials.$inferSelect; lang: Lang; large?: boolean; class?: string }
const { item: x, lang, large = false, class: className = 'mt-6' } = Astro.props;
const photo = thumbUrl(x.photoKey); // Use a thumbnail for the 88px author photo.
const initials = x.authorName.replace(/\s*\(.*\)$/, '').trim().split(/\s+/).slice(-2).map((w) => w[0]).join('').toUpperCase();
const px = large ? 88 : 56;
---
<figcaption class:list={['flex items-center gap-4', className]}>
  {photo
    ? <img src={photo} alt="" width={px} height={px} loading="lazy" decoding="async" class:list={['shrink-0 border-2 border-glory object-cover', large ? 'size-[88px]' : 'size-14']} />
    : <span class:list={['grid shrink-0 place-items-center bg-glory font-display text-white', large ? 'size-[88px] text-3xl' : 'size-14 text-xl']} aria-hidden="true">{initials}</span>}
  <span class="min-w-0">
    <span class="block font-display text-2xl uppercase leading-[1.2] break-words">{x.authorName}</span>
    {x.authorRole && <span class="block text-sm text-ash">{tr(x, 'authorRole', lang)}</span>}
  </span>
</figcaption>
