---
import PublicLayout from '../../layouts/PublicLayout.astro';
import PageHero from '../../components/public/PageHero.astro';
import PostCard from '../../components/public/PostCard.astro';
import Icon from '../../components/public/Icon.astro';
import { publishedPosts, countPublishedPosts } from '../../lib/public';
import { t, href, type Lang } from '../../i18n';

const PER_PAGE = 10;
const lang: Lang = Astro.locals.lang;
const page = Math.max(1, Number.parseInt(Astro.url.searchParams.get('trang') ?? '1', 10) || 1);
const [posts, total] = await Promise.all([publishedPosts(PER_PAGE, (page - 1) * PER_PAGE), countPublishedPosts()]);
const pages = Math.max(1, Math.ceil(total / PER_PAGE));
const pageLink = (n: number) => (n === 1 ? href('/tin-tuc', lang) : `${href('/tin-tuc', lang)}?trang=${n}`);
Astro.response.headers.set('cache-control', 'public, max-age=60');
---
<PublicLayout path="/tin-tuc" title={t(lang, 'news_title')} description={t(lang, 'news_sub')} noindex={page > pages}>
  <PageHero eyebrow={t(lang, 'nav_news')} title={t(lang, 'news_title')} subtitle={t(lang, 'news_sub')} />
  <section class="container-x py-12">
    <div class="mx-auto max-w-2xl space-y-8">
      {posts.length === 0 && <p class="text-center text-white/75 py-16">{t(lang, 'news_empty')}</p>}
      {posts.map((p) => <PostCard post={p} lang={lang} />)}
    </div>
    {pages > 1 && (
      <nav class="mx-auto mt-12 flex max-w-2xl items-center justify-between gap-4" aria-label={t(lang, 'page')}>
        {page > 1 ? <a href={pageLink(page - 1)} class="btn-ghost !text-base"><Icon name="chevron-left" />{t(lang, 'prev')}</a> : <span></span>}
        <span class="font-display tracking-wider text-ash">{t(lang, 'page')} {page}/{pages}</span>
        {page < pages ? <a href={pageLink(page + 1)} class="btn-ghost !text-base">{t(lang, 'next')}<Icon name="chevron-right" /></a> : <span></span>}
      </nav>
    )}
  </section>
</PublicLayout>
