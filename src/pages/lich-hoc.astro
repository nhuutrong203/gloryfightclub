---
import PublicLayout from '../layouts/PublicLayout.astro';
import PageHero from '../components/public/PageHero.astro';
import Icon from '../components/public/Icon.astro';
import CtaBand from '../components/public/CtaBand.astro';
import { mediaUrl, telHref } from '../lib/site';
import { publicClasses, publicCoaches, publicDisciplines } from '../lib/public';
import { vnNow } from '../lib/util';
import { t, tr, href, DAYS, dayShort, dayLong, type Lang } from '../i18n';

const lang: Lang = Astro.locals.lang;
const [{ club, locations }, allClasses, disciplines, coaches] = await Promise.all([Astro.locals.site, publicClasses(), publicDisciplines(), publicCoaches(),
]);
const q = Astro.url.searchParams;
const loc = locations.find((l) => String(l.id) === q.get('co-so')) ?? locations[0];
const mon = disciplines.find((d) => d.slug === q.get('mon'));
const classes = allClasses.filter((c) => c.locationId === loc?.id && (!mon || c.disciplineIds.includes(mon.id)));
const slots = [...new Set(classes.map((c) => `${c.startTime}–${c.endTime}`))].sort();
const cell = (slot: string, d: string) => classes.filter((c) => `${c.startTime}–${c.endTime}` === slot && c.days.includes(d));
const byDay = DAYS.map((d) => ({ d, items: classes.filter((c) => c.days.includes(d)) }));
const today = vnNow().weekday;
const image = mediaUrl(loc?.scheduleImageKey);
const coachName = (id: number | null) => coaches.find((c) => c.id === id)?.fullName;
// Môn đầu tiên của lớp (đang hiện trên web) → bấm vào lớp mở trang môn đó. Open mat không thuộc môn nào → không có link.
const discOf = (c: (typeof classes)[number]) => disciplines.find((d) => c.disciplineIds.includes(d.id));
const link = (params: Record<string, string | undefined>) => {
  const u = new URLSearchParams();
  const merged = { 'co-so': loc ? String(loc.id) : undefined, mon: mon?.slug, ...params };
  for (const [k, v] of Object.entries(merged)) if (v) u.set(k, v);
  return `${href('/lich-hoc', lang)}?${u}`;
};
// Đầu trang: số liệu nhanh của cơ sở đang xem + thẻ "Hôm nay" (lớp tiếp theo, các ca hôm nay) → trang mở ra là thấy lịch, không chỉ chữ.
const locClasses = allClasses.filter((c) => c.locationId === loc?.id);
const weekly = locClasses.reduce((n, c) => n + c.days.length, 0);
const discCount = new Set(locClasses.flatMap((c) => c.disciplineIds).filter((id) => disciplines.some((d) => d.id === id))).size;
const hours = locClasses.length ? `${locClasses.map((c) => c.startTime).sort()[0]}–${locClasses.map((c) => c.endTime).sort().at(-1)}` : null;
const todayItems = classes.filter((c) => c.days.includes(today)).sort((a, b) => a.startTime.localeCompare(b.startTime));
Astro.response.headers.set('cache-control', 'public, max-age=60');
---
<PublicLayout path="/lich-hoc" title={t(lang, 'schedule_title')} description={t(lang, 'schedule_sub')}>
  <PageHero eyebrow={t(lang, 'eb_schedule')} title={t(lang, 'schedule_title')} subtitle={t(lang, 'schedule_sub')}>
    {locClasses.length > 0 && (
      <div class="mt-10 grid gap-6 lg:grid-cols-[1fr_minmax(0,28rem)] lg:items-end">
        <dl class="hero-in grid grid-cols-3 gap-x-4 border-t border-white/15 pt-6 [&_dt]:leading-snug" style="--d:300ms">
          <div><dt class="text-sm text-ash">{t(lang, 'schedule_week')}</dt><dd class="font-display text-4xl sm:text-6xl" data-count={weekly}>{weekly}</dd></div>
          <div><dt class="text-sm text-ash">{t(lang, 'nav_disciplines')}</dt><dd class="font-display text-4xl sm:text-6xl" data-count={discCount}>{discCount}</dd></div>
          {hours && <div><dt class="text-sm text-ash">{t(lang, 'schedule_hours')}</dt><dd class="font-display text-2xl leading-[1.6] sm:text-4xl sm:leading-[1.5] whitespace-nowrap">{hours}</dd></div>}
        </dl>
        <!-- Hôm nay: dòng lớn = lớp đang tập / lớp tiếp theo (script tính theo giờ VN vì trang được cache), chip = các ca hôm nay (ca xong mờ đi). -->
        <div class="hero-in border-l-4 border-glory bg-coal/90 p-5 sm:p-6" style="--d:420ms" data-today
          data-next={t(lang, 'schedule_next')} data-live={t(lang, 'today_live')} data-done={t(lang, 'schedule_done_today')}>
          <p class="eyebrow !mb-2">{t(lang, 'schedule_today')} · {dayLong(today, lang)}</p>
          {todayItems.length === 0
            ? <p class="text-lg text-white/85">{t(lang, 'today_none')}</p>
            : (
              <>
                <p data-today-head class="font-display text-2xl uppercase leading-[1.12] tracking-wide sm:text-3xl" aria-live="polite"></p>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {todayItems.map((c) => (
                    <li data-class-time={`${c.startTime}-${c.endTime}`} data-name={tr(c, 'name', lang)}
                      class="inline-flex items-center gap-2 border border-white/15 px-3 py-1.5 text-sm transition-colors data-[state=done]:opacity-40 data-[state=done]:line-through data-[state=live]:border-glory data-[state=live]:bg-glory data-[state=live]:text-white">
                      <span class="font-display tracking-wide">{c.startTime}</span>{tr(c, 'name', lang)}
                    </li>
                  ))}
                </ul>
              </>
            )}
        </div>
      </div>
    )}
  </PageHero>

  <section class="container-x py-10">
    <!-- Chọn cơ sở -->
    <div class="grid grid-cols-2 gap-px bg-white/10 border border-white/10" role="tablist" aria-label={t(lang, 'f_location')}>
      {locations.map((l) => (
        <a href={link({ 'co-so': String(l.id) })} role="tab" aria-selected={l.id === loc?.id ? 'true' : 'false'}
          class:list={['flex min-h-16 flex-col justify-start px-4 py-3 transition-colors', l.id === loc?.id ? 'bg-glory text-white' : 'bg-ink hover:bg-coal']}>
          <span class="font-display text-xl sm:text-2xl uppercase leading-[1.12]">{tr(l, 'name', lang)}</span>
          <!-- Địa chỉ đầy đủ (trước bị cắt "…" ở cơ sở 2): khách cần đọc hết để tìm đường. -->
          <span class:list={['mt-1 hidden text-sm leading-snug sm:block', l.id === loc?.id ? 'text-white/85' : 'text-ash']}>{l.address}</span>
        </a>
      ))}
    </div>

    <!-- Lọc môn -->
    <!-- Vuốt ngang trên điện thoại; ẩn thanh cuộn xám (chip bị cắt ở mép đã cho biết còn nữa). -->
    <div class="mt-6 -mx-4 px-4 flex gap-2 overflow-x-auto pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" aria-label={t(lang, 'f_discipline')}>
      <a href={link({ mon: '' })} class:list={['shrink-0 min-h-11 inline-flex items-center px-4 border font-display uppercase tracking-wider text-sm', !mon ? 'bg-white text-ink border-white' : 'border-white/20 hover:border-white']}>{t(lang, 'schedule_all')}</a>
      {disciplines.map((d) => (
        <a href={link({ mon: d.slug })} class:list={['shrink-0 min-h-11 inline-flex items-center px-4 border font-display uppercase tracking-wider text-sm', mon?.id === d.id ? 'bg-white text-ink border-white' : 'border-white/20 hover:border-white']}>{tr(d, 'name', lang)}</a>
      ))}
    </div>

    {image && <img src={image} alt={`${t(lang, 'schedule_image_alt')} — ${loc ? tr(loc, 'name', lang) : ''}`} class="mt-8 w-full h-auto border border-white/10" />}

    {classes.length === 0 && !image && (
      <div class="mt-8 border-2 border-dashed border-white/20 p-8 sm:p-12 text-center">
        <Icon name="calendar" class="mx-auto size-12 text-glory" />
        <p class="mt-4 mx-auto max-w-lg text-lg">{t(lang, 'schedule_none')}</p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
          <a href={telHref(club.hotlines[0])} class="btn-red"><Icon name="phone" />{club.hotlines[0]}</a>
          <a href={`https://zalo.me/${club.zalo}`} target="_blank" rel="noopener" class="btn-ghost">Zalo</a>
        </div>
      </div>
    )}

    {classes.length > 0 && (
      <>
        <!-- Desktop: bảng tuần như poster -->
        <div class="mt-8 hidden lg:block border border-white/10">
          <table class="w-full table-fixed border-collapse">
            <thead>
              <tr class="bg-coal">
                <th scope="col" class="w-36 p-3 text-left font-display uppercase tracking-wider text-ash">{t(lang, 'time')}</th>
                {DAYS.map((d) => (
                  <th scope="col" class:list={['p-3 font-display uppercase tracking-wider text-lg', d === today ? 'bg-glory text-white' : d === '8' ? 'text-glory' : '']}>{dayLong(d, lang)}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {slots.map((slot) => (
                <tr class="border-t border-white/10">
                  <th scope="row" class="p-3 text-left font-display text-xl tracking-wide whitespace-nowrap">{slot}</th>
                  {DAYS.map((d) => (
                    <td class:list={['border-l border-white/10 p-2 align-top', d === today && 'bg-glory/[0.07]']}>
                      {cell(slot, d).map((c) => {
                        // Bấm vào lớp → trang môn đó. Cột hôm nay: ca đang tập sáng đỏ, ca đã xong mờ đi (script trong PublicLayout).
                        const disc = discOf(c);
                        const Tag = disc ? 'a' : 'div';
                        return (
                          <Tag href={disc ? href(`/mon-hoc/${disc.slug}`, lang) : undefined} data-class-time={d === today ? `${c.startTime}-${c.endTime}` : undefined}
                            class="group/c mb-1 block border-l-2 border-transparent bg-coal px-3 py-2 transition-colors duration-200 last:mb-0 hover:border-glory hover:bg-white/[0.08] data-[state=done]:opacity-50 data-[state=live]:border-glory data-[state=live]:bg-glory/20">
                            <p class="font-display uppercase leading-[1.12] tracking-wide">{tr(c, 'name', lang)}</p>
                            {coachName(c.coachId) && <p class="mt-0.5 text-xs leading-snug text-ash group-hover/c:text-white/80">{coachName(c.coachId)}</p>}
                            <p class="mt-1 hidden items-center gap-1.5 font-display text-xs uppercase tracking-widest text-white group-data-[state=live]/c:flex">
                              <span class="size-1.5 animate-pulse rounded-full bg-glory-bright motion-reduce:animate-none" aria-hidden="true"></span>{t(lang, 'today_live')}
                            </p>
                          </Tag>
                        );
                      })}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Mobile/tablet: theo từng ngày -->
        <div class="lg:hidden" data-days>
          <div class="sticky top-16 z-20 -mx-4 mt-8 grid grid-cols-7 border-y border-white/10 bg-ink/95 backdrop-blur" role="tablist" aria-label={t(lang, 'schedule_title')}>
            {DAYS.map((d) => (
              <a href={`#d${d}`} role="tab" data-day={d} aria-selected={d === today ? 'true' : 'false'}
                class="relative grid min-h-12 place-items-center font-display tracking-wider transition-colors duration-200 aria-selected:bg-glory aria-selected:text-white hover:text-glory aria-selected:hover:text-white">
                {dayShort(d, lang)}
                {d === today && <span class="absolute bottom-1 size-1 rounded-full bg-current" aria-hidden="true"></span>}
              </a>
            ))}
          </div>
          <div class="mt-6 space-y-8">
            {byDay.map(({ d, items }) => (
              <section id={`d${d}`} data-panel={d} role="tabpanel" class="scroll-mt-32">
                <h2 class:list={['flex items-center gap-3 text-3xl', d === today && 'text-glory']}>{dayLong(d, lang)}{d === today && <span class="bg-glory px-2 py-0.5 text-sm text-white tracking-widest">{t(lang, 'schedule_today')}</span>}</h2>
                {items.length === 0
                  ? <p class="mt-3 border border-dashed border-white/15 p-6 text-center text-ash">{t(lang, 'schedule_day_empty')}</p>
                  : (
                    <ul class="mt-3 space-y-2">
                      {items.map((c, i) => {
                        const disc = discOf(c);
                        const Tag = disc ? 'a' : 'div';
                        return (
                          <li class="day-item" style={`--i:${i}`}>
                            <Tag href={disc ? href(`/mon-hoc/${disc.slug}`, lang) : undefined} data-class-time={d === today ? `${c.startTime}-${c.endTime}` : undefined}
                              class="group/c flex items-stretch border border-white/10 bg-coal transition-colors duration-200 active:bg-white/[0.08] data-[state=done]:opacity-50 data-[state=live]:border-glory data-[state=live]:bg-glory/15">
                              <span class="flex w-24 shrink-0 flex-col justify-center border-r border-white/10 px-3 py-3 font-display text-xl leading-tight">{c.startTime}<span class="text-ash text-base">{c.endTime}</span></span>
                              <span class="flex min-w-0 flex-1 flex-col justify-center px-4 py-3">
                                <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                  <span class="font-display text-xl uppercase tracking-wide leading-[1.12]">{tr(c, 'name', lang)}</span>
                                  <span class="hidden items-center gap-1.5 bg-glory px-2 py-1 font-display text-xs leading-none tracking-widest text-white group-data-[state=live]/c:inline-flex">
                                    <span class="size-2 animate-pulse rounded-full bg-white motion-reduce:animate-none" aria-hidden="true"></span>{t(lang, 'today_live')}
                                  </span>
                                </span>
                                {coachName(c.coachId) && <span class="text-sm text-ash">{t(lang, 'coach')} {coachName(c.coachId)}</span>}
                              </span>
                              {disc && <Icon name="chevron-right" class="mr-3 size-5 shrink-0 self-center text-ash" />}
                            </Tag>
                          </li>
                        );
                      })}
                    </ul>
                  )}
              </section>
            ))}
          </div>
        </div>
      </>
    )}

    <div class="mt-10 flex flex-col gap-4 border-l-4 border-glory bg-coal p-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-display text-2xl uppercase">{t(lang, 'open_mat_name')} <span class="text-glory">{t(lang, 'free')}</span> · {t(lang, 'open_mat_time')}</p>
      <a href={href('/hoc-phi', lang)} class="inline-flex min-h-11 items-center gap-2 font-display uppercase tracking-wider hover:text-glory">{t(lang, 'nav_fees')}<Icon name="arrow-right" /></a>
    </div>
  </section>
  <CtaBand lang={lang} />
</PublicLayout>

<script>
  // Thẻ "Hôm nay" ở đầu trang: dòng lớn = lớp đang tập, không thì lớp tiếp theo, hết lớp thì lời hẹn ngày mai (giờ VN, cập nhật mỗi phút).
  const card = document.querySelector<HTMLElement>('[data-today]');
  const head = card?.querySelector<HTMLElement>('[data-today-head]');
  if (card && head) {
    const hhmm = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Ho_Chi_Minh', hour: '2-digit', minute: '2-digit', hour12: false });
    const items = [...card.querySelectorAll<HTMLElement>('[data-class-time]')];
    const update = () => {
      const now = hhmm.format(new Date());
      const at = (el: HTMLElement) => el.dataset.classTime!.split('-');
      const live = items.find((el) => { const [s, e] = at(el); return now >= s && now < e; });
      const next = items.find((el) => at(el)[0] > now);
      head.textContent = live ? `${card.dataset.live}: ${live.dataset.name}`
        : next ? `${card.dataset.next}: ${at(next)[0]} · ${next.dataset.name}` : card.dataset.done ?? '';
    };
    update();
    setInterval(update, 60_000);
  }

  // Điện thoại: chỉ hiện ngày đang chọn (mặc định hôm nay). Không có JS thì hiện cả tuần như cũ.
  const root = document.querySelector<HTMLElement>('[data-days]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('[data-day]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const show = (day: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.day === day)));
      panels.forEach((p) => {
        const on = p.dataset.panel === day;
        p.hidden = !on;
        if (on) p.querySelectorAll('.day-item').forEach((li) => { li.classList.remove('day-in'); void (li as HTMLElement).offsetWidth; li.classList.add('day-in'); });
      });
    };
    tabs.forEach((t) => t.addEventListener('click', (e) => { e.preventDefault(); show(t.dataset.day!); }));
    const initial = location.hash.match(/^#d([2-8])$/)?.[1] ?? tabs.find((t) => t.getAttribute('aria-selected') === 'true')?.dataset.day ?? '2';
    show(initial);
  }
</script>
<style>
  .day-in { animation: day-in .35s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--i, 0) * 40ms); }
  @keyframes day-in { from { opacity: 0; transform: translateX(16px); } }
  @media (prefers-reduced-motion: reduce) { .day-in { animation: none; } }
</style>
