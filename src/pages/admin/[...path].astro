---
import '../../styles/global.css';
import App from '../../admin/App';
import { env } from 'cloudflare:workers';
// CMS shell. React loads its data from authenticated admin APIs.
Astro.response.headers.set('cache-control', 'no-store');
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Glory CMS</title>
    <meta name="glory-hosts" content={`${env.PUBLIC_HOST}|${env.CMS_HOST}`} />
  </head>
  <body class="admin">
    <App client:only="react" />
  </body>
</html>
<style is:global>
  /* Use a light background for CMS readability. */
  html:has(body.admin) { background: #f5f5f5; color: #0a0a0a; }
</style>
