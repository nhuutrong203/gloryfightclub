---
import { eq, and, asc } from 'drizzle-orm';
import PublicLayout from '../../layouts/PublicLayout.astro';
import Logo from '../../components/Logo.astro';
import Icon from '../../components/public/Icon.astro';
import ClassList from '../../components/public/ClassList.astro';
import CtaBand from '../../components/public/CtaBand.astro';
import AchievementIcon from '../../components/public/AchievementIcon.astro';
import MedalTally from '../../components/public/MedalTally.astro';
import { db, schema } from '../../db';
import { mediaUrl, thumbSrcset, thumbUrl } from '../../lib/site';
import { publicCoaches, publicClasses, publicDisciplines, lines, richText } from '../../lib/public';
import { extraAwards } from '../../lib/medals';
import { t, tr, href, type Lang } from '../../i18n';

const lang: Lang = Astro.locals.lang;
const [{ locations }, coaches, classes, disciplines] = await Promise.all([Astro.locals.site, publicCoaches(), publicClasses(), publicDisciplines()]);
const c = coaches.find((x) => x.slug === Astro.params.slug);
if (!c) return Astro.rewrite('/404');
const achievementRows = await db.select().from(schema.achievements)
  .where(and(eq(schema.achievements.coachId, c.id), eq(schema.achievements.isPublic, true))).orderBy(asc(schema.achievements.sort));
const achievements = lines(tr(c, 'achievements', lang));
// Append linked awards missing from the written achievements.
const extraRows = extraAwards(achievements, achievementRows, (r) => ({ title: tr(r, 'title', lang), event: r.eventName }));
const myClasses = classes.filter((x) => x.coachId === c.id);
const myDisciplines = disciplines.filter((d) => c.disciplineIds.includes(d.id));
const photo = mediaUrl(c.photoKey);
const others = coaches.filter((x) => x.id !== c.id);
const desc = [tr(c, 'title', lang), achievements[0]].filter(Boolean).join(' — ');
Astro.response.headers.set('cache-control', 'public, max-age=60');
---
<PublicLayout path={`/huan-luyen-vien/${c.slug}`} title={c.fullName} description={desc} image={photo}>
  <section class="relative isolate overflow-hidden border-b border-white/10">
    <div class="container-x grid gap-10 py-10 sm:py-16 lg:grid-cols-[5fr_7fr] lg:items-end">
      <div class="relative aspect-[4/5] overflow-hidden bg-coal">
        {photo
          ? <img src={photo} alt={c.fullName} class="size-full object-cover" />
          : (
            <div class="relative size-full overflow-hidden bg-[radial-gradient(circle_at_70%_15%,#2b0d0c,#0a0a0a_65%)]">
              <Logo class="absolute -right-[18%] -top-[8%] h-[85%] w-auto text-white/[0.06]" title="" />
              <span class="absolute bottom-4 left-5 font-display text-[clamp(6rem,30vw,12rem)] leading-none text-outline-white" aria-hidden="true">{c.fullName.trim().split(/\s+/).slice(-2).map((w) => w[0]).join('')}</span>
            </div>
          )}
        <div class="absolute left-0 bottom-0 h-2 w-2/3 bg-glory"></div>
      </div>
      <div>
        <a href={href('/huan-luyen-vien', lang)} class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-ash hover:text-white"><Icon name="arrow-left" class="size-4" />{t(lang, 'coaches_label')}</a>
        <p class="eyebrow mt-4">{tr(c, 'title', lang)}</p>
        <h1 class="mt-3 text-6xl sm:text-8xl">{c.fullName}</h1>
        {myDisciplines.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {myDisciplines.map((d) => <a href={href(`/mon-hoc/${d.slug}`, lang)} class="min-h-11 inline-flex items-center border border-white/25 px-4 font-display uppercase tracking-wider hover:border-glory hover:text-glory">{tr(d, 'name', lang)}</a>)}
          </div>
        )}
        {tr(c, 'bio', lang) && <div class="mt-8 max-w-2xl text-lg text-white/85" set:html={richText(tr(c, 'bio', lang))} />}
      </div>
    </div>
  </section>

  {(achievements.length > 0 || achievementRows.length > 0) && (
    <section class="bg-bone text-ink py-14 sm:py-20">
      <div class="container-x">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 class="text-5xl sm:text-7xl">{t(lang, 'achievements_title')}</h2>
          <MedalTally lines={[...achievements, ...extraRows.map((r) => tr(r, 'title', lang))]} lang={lang} size="lg" />
        </div>
        <ul class="mt-10 grid gap-px bg-ink/15 border border-ink/15 sm:grid-cols-2">
          {achievements.map((a, i) => (
            <li class="reveal flex items-start gap-4 bg-bone p-6 transition-colors hover:bg-white" style={`--i:${i}`}>
              <AchievementIcon line={a} class="size-10" />
              <span class="font-display text-2xl sm:text-3xl uppercase leading-tight">{a}</span>
            </li>
          ))}
          {/* Linked awards not already included in the written achievements. */}
          {extraRows.map((r, i) => (
            <li class="reveal flex items-start gap-4 bg-bone p-6 transition-colors hover:bg-white" style={`--i:${i}`}>
              <AchievementIcon line={tr(r, 'title', lang)} class="size-10" />
              <span><span class="block font-display text-2xl sm:text-3xl uppercase leading-tight">{tr(r, 'title', lang)}</span>{r.eventName && <span class="text-ink/70">{r.eventName}</span>}</span>
            </li>
          ))}
        </ul>
        {achievementRows.some((r) => r.imageKey) && (
          <div class="mt-12">
            <h3 class="text-3xl sm:text-4xl">{t(lang, 'achievements_photos')}</h3>
            <ul class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
              {achievementRows.filter((r) => r.imageKey).map((r, i) => (
                <li class="reveal" style={`--i:${i % 3}`}>
                  <a href={mediaUrl(r.imageKey)} data-lightbox="coach-achievements" data-caption={tr(r, 'title', lang)} class="group block overflow-hidden bg-ink">
                    <img src={thumbUrl(r.imageKey)} srcset={thumbSrcset(r.imageKey)} sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 33vw" alt={tr(r, 'title', lang)} loading="lazy" class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                  </a>
                  <p class="mt-2 font-display text-lg uppercase leading-snug sm:text-xl">{tr(r, 'title', lang)}</p>
                  {r.eventName && <p class="text-sm text-ink/70">{r.eventName}{r.eventDate && ` · ${r.eventDate.slice(0, 4)}`}</p>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  {myClasses.length > 0 && (
    <section class="container-x py-14">
      <h2 class="text-4xl sm:text-5xl">{t(lang, 'classes_label')}</h2>
      <div class="mt-6"><ClassList classes={myClasses} lang={lang} locations={locations} /></div>
    </section>
  )}

  {others.length > 0 && (
    <nav class="container-x py-14" aria-label={t(lang, 'coaches_label')}>
      <p class="eyebrow">{t(lang, 'coaches_title')}</p>
      <div class="mt-4 grid gap-px bg-white/10 border border-white/10 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((o) => (
          <a href={href(`/huan-luyen-vien/${o.slug}`, lang)} class="group flex items-center justify-between gap-4 bg-ink p-5 hover:bg-coal">
            <span><span class="block font-display text-2xl uppercase group-hover:text-glory">{o.fullName}</span><span class="text-sm text-ash">{tr(o, 'title', lang)}</span></span>
            <Icon name="arrow-right" class="size-5 shrink-0" />
          </a>
        ))}
      </div>
    </nav>
  )}
  <CtaBand lang={lang} />
</PublicLayout>
