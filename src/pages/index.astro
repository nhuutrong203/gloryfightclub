---
import PublicLayout from '../layouts/PublicLayout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/public/Icon.astro';
import Marquee from '../components/public/Marquee.astro';
import PlanCard from '../components/public/PlanCard.astro';
import CoachCard from '../components/public/CoachCard.astro';
import PostCard from '../components/public/PostCard.astro';
import CtaBand from '../components/public/CtaBand.astro';
import { getSite, mediaUrl } from '../lib/site';
import {
  todayDigit, publicDisciplines, publicCoaches, publicPlans, publicClasses,
  publishedPosts, publicTestimonials, publicAchievements,
} from '../lib/public';
import { t, tr, href, dayLong, type Lang } from '../i18n';

const lang: Lang = Astro.locals.lang;
const { hero, locations } = await getSite();
const [disciplines, coaches, plans, classes, posts, testimonials, achievements] = await Promise.all([
  publicDisciplines(), publicCoaches(), publicPlans(), publicClasses(),
  publishedPosts(3), publicTestimonials(), publicAchievements(),
]);
const today = todayDigit();
const todayByLoc = locations
  .map((l) => ({ l, items: classes.filter((c) => c.locationId === l.id && c.days.includes(today)) }))
  .filter((x) => x.items.length);
const heroImage = mediaUrl(hero.image_key);
const titleParts: string[] = (lang === 'en' ? hero.title_en : hero.title)?.split('–') ?? ['NO PAIN', 'NO GLORY'];
const coachName = (id: number | null) => coaches.find((c) => c.id === id)?.fullName;
Astro.response.headers.set('cache-control', 'public, max-age=60');
---
<PublicLayout path="/">
  <!-- HERO -->
  <section class="relative isolate overflow-hidden min-h-[calc(100dvh-8rem)] lg:min-h-[calc(100dvh-4rem)] flex items-end">
    {heroImage
      ? <img src={heroImage} alt="" class="absolute inset-0 -z-20 size-full object-cover opacity-60" fetchpriority="high" />
      : <Logo class="absolute -z-20 -right-28 top-1/2 -translate-y-1/2 h-[125%] w-auto text-white/[0.05]" title="" />}
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/70 to-ink/10"></div>
    <div class="absolute -z-10 right-0 top-0 h-full w-24 sm:w-40 bg-glory/90 -skew-x-[14deg] translate-x-16 sm:translate-x-24"></div>
    <div class="container-x pb-14 pt-24 sm:pb-20">
      <p class="eyebrow hero-in flex items-center gap-3 !text-xs sm:!text-sm"><span class="h-0.5 w-10 shrink-0 bg-glory"></span>{disciplines.map((d) => tr(d, 'name', lang)).join(' · ')}</p>
      <h1 class="text-[clamp(3.5rem,15vw,11rem)]">
        {titleParts.map((part, i) => <span class:list={['hero-in block', i === 1 && 'text-glory']} style={`--d:${120 + i * 110}ms`}>{part.trim()}</span>)}
      </h1>
      <p class="hero-in mt-6 max-w-xl text-lg sm:text-xl text-white/85" style="--d:380ms">{lang === 'en' ? hero.subtitle_en : hero.subtitle}</p>
      <div class="hero-in mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4" style="--d:480ms">
        <a href={href('/dang-ky-hoc-thu', lang)} class="btn-red !text-xl !px-8">{t(lang, 'cta_trial')}<Icon name="arrow-right" /></a>
        <a href={href('/lich-hoc', lang)} class="btn-ghost !text-xl !px-8"><Icon name="calendar" />{t(lang, 'nav_schedule')}</a>
      </div>
      <dl class="hero-in mt-12 grid max-w-2xl grid-cols-3 border-t border-white/15 pt-6" style="--d:580ms">
        <div><dt class="text-sm text-ash">{t(lang, 'nav_disciplines')}</dt><dd class="font-display text-4xl sm:text-5xl">{disciplines.length}</dd></div>
        <div><dt class="text-sm text-ash">{t(lang, 'coaches_label')}</dt><dd class="font-display text-4xl sm:text-5xl">{coaches.length}</dd></div>
        <div><dt class="text-sm text-ash">{t(lang, 'locations_title')}</dt><dd class="font-display text-4xl sm:text-5xl">{locations.length}</dd></div>
      </dl>
    </div>
  </section>

  <Marquee />

  <!-- HÔM NAY -->
  <section class="container-x py-16 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">{dayLong(today, lang)}</p>
        <h2 class="mt-2 text-5xl sm:text-6xl">{t(lang, 'today_title')}</h2>
      </div>
      <a href={href('/lich-hoc', lang)} class="inline-flex min-h-11 items-center gap-2 font-display uppercase tracking-wider hover:text-glory">{t(lang, 'cta_all')}<Icon name="arrow-right" /></a>
    </div>
    {todayByLoc.length === 0
      ? <p class="mt-8 text-white/75">{t(lang, 'today_none')}</p>
      : (
        <div class:list={['mt-8 grid gap-px bg-white/10 border border-white/10', todayByLoc.length > 1 && 'lg:grid-cols-2']}>
          {todayByLoc.map(({ l, items }) => (
            <div class="bg-ink p-5 sm:p-6">
              <p class="flex items-center gap-2 font-semibold text-ash"><Icon name="map-pin" class="size-4 text-glory" />{tr(l, 'name', lang)}</p>
              <ul class="mt-4 space-y-2">
                {items.map((c, i) => (
                  <li class="reveal flex items-baseline gap-4 border-l-4 border-glory bg-coal px-4 py-3" style={`--i:${i}`}>
                    <span class="font-display text-2xl tracking-wide w-32 shrink-0">{c.startTime}<span class="text-ash">–{c.endTime}</span></span>
                    <span class="min-w-0">
                      <span class="font-display text-2xl uppercase tracking-wide">{tr(c, 'name', lang)}</span>
                      {coachName(c.coachId) && <span class="block text-sm text-ash">{coachName(c.coachId)}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
  </section>

  <!-- MÔN HỌC -->
  <section class="border-t border-white/10 py-16 sm:py-24">
    <div class="container-x">
      <div class="grid gap-4 lg:grid-cols-2 lg:items-end">
        <h2 class="text-6xl sm:text-8xl">{t(lang, 'disciplines_title')}</h2>
        <p class="text-lg text-white/75 lg:text-right">{t(lang, 'disciplines_sub')}</p>
      </div>
      <div class="mt-12 grid gap-px bg-white/10 border border-white/10 sm:grid-cols-2 lg:grid-cols-3">
        {disciplines.map((d, i) => (
          <a href={href(`/mon-hoc/${d.slug}`, lang)} class:list={['reveal group relative overflow-hidden bg-ink p-7 sm:p-9 min-h-72 flex flex-col transition-colors duration-200 hover:bg-glory']} style={`--i:${i}`}>
            <span class="font-display text-7xl text-outline-white leading-none group-hover:[-webkit-text-stroke-color:rgb(255_255_255/0.6)]" aria-hidden="true">0{i + 1}</span>
            <h3 class="mt-auto pt-10 text-4xl sm:text-5xl">{tr(d, 'name', lang)}</h3>
            <p class="mt-3 text-white/75 group-hover:text-white line-clamp-3">{tr(d, 'summary', lang)}</p>
            <Icon name="arrow-up-right" class="absolute right-6 top-6 size-8 transition-transform duration-200 group-hover:translate-x-1 group-hover:-translate-y-1" />
          </a>
        ))}
        <a href={href('/dang-ky-hoc-thu', lang)} class="reveal group bg-bone text-ink p-7 sm:p-9 min-h-72 flex flex-col justify-between hover:bg-white" style={`--i:${disciplines.length}`}>
          <Icon name="arrow-up-right" class="size-10 text-glory" />
          <span class="font-display text-4xl sm:text-5xl uppercase leading-[1.12]">{t(lang, 'cta_trial')}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- FIGHTERS OF GLORY -->
  <section class="relative bg-bone text-ink py-16 sm:py-24 overflow-hidden">
    <span class="pointer-events-none absolute -top-6 right-0 font-display text-[22vw] leading-none text-ink/[0.04] select-none" aria-hidden="true">GLORY</span>
    <div class="container-x relative">
      <p class="eyebrow !text-glory-dark">{t(lang, 'coaches_label')}</p>
      <h2 class="mt-2 text-6xl sm:text-8xl">{t(lang, 'coaches_title')}</h2>
      <p class="mt-3 text-lg text-ink/75">{t(lang, 'coaches_sub')}</p>
      <div class="mt-12 -mx-4 px-4 sm:mx-0 sm:px-0 flex gap-5 overflow-x-auto snap-x snap-mandatory pb-6 lg:grid lg:grid-cols-3 lg:overflow-visible">
        {coaches.map((c, i) => <CoachCard coach={c} lang={lang} i={i} tone="light" class="snap-start shrink-0 w-[64%] sm:w-80 lg:w-auto" />)}
      </div>
    </div>
  </section>

  <!-- THÀNH TÍCH -->
  {achievements.length > 0 && (
    <section class="bg-ink py-16 sm:py-20 border-b border-white/10">
      <div class="container-x">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="text-5xl sm:text-7xl">{t(lang, 'achievements_title')}</h2>
          <a href={href('/thanh-tich', lang)} class="inline-flex min-h-11 items-center gap-2 font-display uppercase tracking-wider hover:text-glory">{t(lang, 'cta_all')}<Icon name="arrow-right" /></a>
        </div>
        <ul class="mt-10 grid gap-px bg-white/10 border border-white/10 sm:grid-cols-2 lg:grid-cols-4">
          {[...achievements].sort((x, y) => Number(!!y.imageKey) - Number(!!x.imageKey)).slice(0, 4).map((a, i) => (
            <li class="reveal bg-ink p-6" style={`--i:${i}`}>
              {a.imageKey
                ? <a href={mediaUrl(a.imageKey)} target="_blank" rel="noopener" class="group -mx-6 -mt-6 mb-5 block aspect-[4/3] overflow-hidden"><img src={mediaUrl(a.imageKey)} alt={tr(a, 'title', lang)} loading="lazy" class="size-full object-cover transition-transform duration-500 group-hover:scale-105" /></a>
                : <Icon name="medal" class="size-9 text-glory" />}
              <p class="mt-4 font-display text-3xl uppercase leading-tight">{tr(a, 'title', lang)}</p>
              {a.eventName && <p class="mt-2 text-white/75">{a.eventName}</p>}
              {coachName(a.coachId) && <p class="mt-1 text-sm text-ash">{coachName(a.coachId)}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- HỌC PHÍ -->
  <section class="container-x py-16 sm:py-24">
    <div class="grid gap-4 lg:grid-cols-2 lg:items-end">
      <h2 class="text-6xl sm:text-8xl">{t(lang, 'fees_title')}</h2>
      <p class="text-lg text-white/75 lg:text-right">{t(lang, 'fees_sub')}</p>
    </div>
    <div class="mt-14 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {plans.map((p, i) => <PlanCard plan={p} lang={lang} i={i} />)}
    </div>
    <div class="mt-10 flex flex-col gap-4 border-2 border-white/15 p-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-display text-3xl uppercase">{t(lang, 'open_mat')} <span class="text-glory italic">{t(lang, 'free')}</span></p>
      <p class="flex items-center gap-2 font-display text-2xl tracking-wide"><Icon name="calendar" class="size-6 text-glory" />{t(lang, 'open_mat_time')}</p>
    </div>
  </section>

  <!-- TIN TỨC -->
  {posts.length > 0 && (
    <section class="border-t border-white/10 py-16 sm:py-24">
      <div class="container-x">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 class="text-5xl sm:text-7xl">{t(lang, 'news_title')}</h2>
            <p class="mt-2 text-white/75">{t(lang, 'news_sub')}</p>
          </div>
          <a href={href('/tin-tuc', lang)} class="inline-flex min-h-11 items-center gap-2 font-display uppercase tracking-wider hover:text-glory">{t(lang, 'cta_all')}<Icon name="arrow-right" /></a>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3 items-start">
          {posts.map((p, i) => <PostCard post={p} lang={lang} i={i} />)}
        </div>
      </div>
    </section>
  )}

  <!-- CẢM NHẬN -->
  {testimonials.length > 0 && (
    <section class="bg-coal py-16 sm:py-24">
      <div class="container-x">
        <h2 class="text-5xl sm:text-7xl">{t(lang, 'testimonials_title')}</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {testimonials.slice(0, 4).map((x, i) => (
            <figure class="reveal relative border-l-4 border-glory bg-ink p-6 sm:p-8" style={`--i:${i}`}>
              <Icon name="quote" class="size-10 text-glory/40" filled />
              <blockquote class="mt-4 text-lg text-white/90">{tr(x, 'content', lang)}</blockquote>
              <figcaption class="mt-6"><span class="font-display text-2xl uppercase">{x.authorName}</span>{x.authorRole && <span class="block text-sm text-ash">{tr(x, 'authorRole', lang)}</span>}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CƠ SỞ -->
  <section class="container-x py-16 sm:py-24">
    <h2 class="text-5xl sm:text-7xl">{t(lang, 'locations_title')}</h2>
    <div class="mt-10 grid gap-px bg-white/10 border border-white/10 md:grid-cols-2">
      {locations.map((l, i) => (
        <div class="reveal relative overflow-hidden bg-ink p-7 sm:p-10" style={`--i:${i}`}>
          <span class="pointer-events-none absolute -bottom-10 right-2 font-display text-[11rem] leading-none text-white/[0.05]" aria-hidden="true">{i + 1}</span>
          <p class="eyebrow">{tr(l, 'name', lang)}</p>
          <p class="relative mt-4 max-w-sm text-lg leading-relaxed">{l.address}</p>
          <div class="relative mt-6 flex flex-wrap gap-3">
            {l.mapUrl && <a href={l.mapUrl} target="_blank" rel="noopener" class="btn-ghost !text-base"><Icon name="map-pin" />{t(lang, 'directions')}</a>}
            <a href={`${href('/lich-hoc', lang)}?co-so=${l.id}`} class="btn !text-base border-2 border-white/20 hover:border-glory hover:text-glory"><Icon name="calendar" />{t(lang, 'nav_schedule')}</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <CtaBand lang={lang} />
</PublicLayout>
