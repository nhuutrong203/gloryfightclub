---
import PublicLayout from '../layouts/PublicLayout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/public/Icon.astro';
import Marquee from '../components/public/Marquee.astro';
import PlanCard from '../components/public/PlanCard.astro';
import CoachCard from '../components/public/CoachCard.astro';
import PostCard from '../components/public/PostCard.astro';
import CtaBand from '../components/public/CtaBand.astro';
import TestimonialBand from '../components/public/TestimonialBand.astro';
import AchievementIcon from '../components/public/AchievementIcon.astro';
import { mediaUrl, thumbSrcset, thumbUrl } from '../lib/site';
import { vnNow } from '../lib/util';
import {
  publicDisciplines, publicCoaches, publicPlans, publicClasses,
  publishedPosts, publicTestimonials, publicAchievements,
} from '../lib/public';
import { t, tr, href, dayLong, type Lang } from '../i18n';

const lang: Lang = Astro.locals.lang;
const { hero, locations, club } = Astro.locals.site;
const [disciplines, coaches, plans, classes, posts, testimonials, achievements] = await Promise.all([
  publicDisciplines(), publicCoaches(), publicPlans(), publicClasses(),
  publishedPosts(3), publicTestimonials(), publicAchievements(),
]);
const today = vnNow().weekday;
const todayByLoc = locations
  .map((l) => ({ l, items: classes.filter((c) => c.locationId === l.id && c.days.includes(today)) }))
  .filter((x) => x.items.length);
const heroImage = mediaUrl(hero.image_key);
const titleParts: string[] = (lang === 'en' ? hero.title_en : hero.title)?.split('–') ?? ['NO PAIN', 'NO GLORY'];
const coachName = (id: number | null) => coaches.find((c) => c.id === id)?.fullName;
// Ô "Nổi bật ở trang chủ" trong CMS → HLV quyết định ai hiện ở đây; chưa tích ai thì hiện tất cả (như trước).
const homeCoaches = coaches.some((c) => c.isFeatured) ? coaches.filter((c) => c.isFeatured) : coaches;
// Google: CLB võ (SportsClub) + từng cơ sở có địa chỉ → dễ hiện tên, số điện thoại, bản đồ trong kết quả tìm kiếm.
const site = Astro.site!;
const jsonLd = {
  '@type': 'SportsClub', name: club.name, url: new URL(href('/', lang), site).href, logo: new URL('/favicon.svg', site).href,
  image: new URL(heroImage ?? '/og-default.png', site).href, description: lang === 'en' ? club.tagline_en || club.tagline : club.tagline,
  telephone: club.hotlines[0], sameAs: [club.facebook, club.instagram].filter(Boolean),
  sport: disciplines.map((d) => tr(d, 'name', lang)),
  location: locations.map((l) => ({ '@type': 'SportsActivityLocation', name: tr(l, 'name', lang), telephone: l.phone ?? club.hotlines[0],
    address: { '@type': 'PostalAddress', streetAddress: l.address, addressLocality: 'Thành phố Hồ Chí Minh', addressCountry: 'VN' }, ...(l.mapUrl ? { hasMap: l.mapUrl } : {}) })),
};
Astro.response.headers.set('cache-control', 'public, max-age=60');
---
<PublicLayout path="/" jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="spot grain relative isolate overflow-hidden min-h-[calc(100dvh-8rem)] lg:min-h-[calc(100dvh-4rem)] flex items-end" data-spot>
    {heroImage
      ? <img src={heroImage} alt="" class="hero-media absolute inset-0 -z-20 size-full object-cover opacity-60" fetchpriority="high" />
      : <Logo class="absolute -z-20 -right-28 top-1/2 -translate-y-1/2 h-[125%] w-auto text-white/[0.05]" title="" />}
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/70 to-ink/10"></div>
    <div class="stripe-in absolute -z-10 right-0 top-0 h-full w-24 sm:w-40 origin-right bg-glory/90 -skew-x-[14deg] translate-x-16 sm:translate-x-24"></div>
    <div class="container-x pb-14 pt-24 sm:pb-20">
      <p class="eyebrow hero-in flex items-center gap-3 !text-xs sm:!text-sm"><span class="h-0.5 w-10 shrink-0 bg-glory"></span>{disciplines.map((d) => tr(d, 'name', lang)).join(' · ')}</p>
      <h1 class="text-[clamp(3.5rem,15vw,11rem)]">
        <!-- Dòng 1 trồi lên sau mép cắt; dòng 2 (đỏ) lộ ra sau khối trắng quét ngang. -->
        {titleParts.map((part, i) => i === 0
          ? <span class="hero-line block" style="--d:120ms">{part.trim()}</span>
          : <span class="block text-glory"><span class="block-reveal" style={`--d:${260 + i * 120}ms`}>{part.trim()}</span></span>)}
      </h1>
      <p class="hero-in mt-6 max-w-xl text-lg sm:text-xl text-white/85" style="--d:380ms">{lang === 'en' ? hero.subtitle_en : hero.subtitle}</p>
      <div class="hero-in mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4" style="--d:480ms">
        <a href={href('/dang-ky-hoc-thu', lang)} class="btn-red !text-xl !px-8" data-magnetic>{t(lang, 'cta_trial')}<Icon name="arrow-right" /></a>
        <a href={href('/lich-hoc', lang)} class="btn-ghost !text-xl !px-8"><Icon name="calendar" />{t(lang, 'nav_schedule')}</a>
      </div>
      <p class="mt-5 max-w-xl text-sm leading-relaxed text-white/80">{t(lang, 'home_beginner_note')}</p>
      <nav class="mt-2 flex flex-wrap gap-x-6 gap-y-1 text-sm font-semibold" aria-label={t(lang, 'home_quick_links')}>
        <a href={href('/hoc-phi', lang)} class="inline-flex min-h-11 items-center gap-1 underline underline-offset-4 hover:text-glory-bright">{t(lang, 'nav_fees')}<Icon name="arrow-right" class="size-4" /></a>
        <a href={href('/lien-he', lang)} class="inline-flex min-h-11 items-center gap-1 underline underline-offset-4 hover:text-glory-bright">{t(lang, 'locations_title')}<Icon name="arrow-right" class="size-4" /></a>
      </nav>
      <dl class="hero-in mt-12 grid max-w-2xl grid-cols-3 gap-x-4 border-t border-white/15 pt-6 [&_dt]:leading-snug" style="--d:580ms">
        <div><dt class="text-sm text-ash">{t(lang, 'nav_disciplines')}</dt><dd class="font-display text-4xl sm:text-5xl">{disciplines.length}</dd></div>
        <div><dt class="text-sm text-ash">{t(lang, 'coaches_label')}</dt><dd class="font-display text-4xl sm:text-5xl">{coaches.length}</dd></div>
        <div><dt class="text-sm text-ash">{t(lang, 'locations_title')}</dt><dd class="font-display text-4xl sm:text-5xl">{locations.length}</dd></div>
      </dl>
    </div>
    <!-- Gợi ý cuộn xuống (trang trí, chỉ màn rộng). -->
    <div class="pointer-events-none absolute bottom-8 right-8 hidden flex-col items-center gap-2 lg:flex" aria-hidden="true">
      <span class="h-14 w-px bg-white/30"></span>
      <Icon name="chevron-down" class="scroll-cue size-6 text-glory" />
    </div>
  </section>

  <Marquee />

  <!-- HÔM NAY -->
  <section class="container-x py-16 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">{dayLong(today, lang)}</p>
        <h2 class="mt-2 text-5xl sm:text-6xl">{t(lang, 'today_title')}</h2>
      </div>
      <a href={href('/lich-hoc', lang)} class="inline-flex min-h-11 items-center gap-2 font-display uppercase tracking-wider hover:text-glory">{t(lang, 'cta_all')}<Icon name="arrow-right" /></a>
    </div>
    {todayByLoc.length === 0
      ? <p class="mt-8 text-white/75">{t(lang, 'today_none')}</p>
      : (
        <div class:list={['mt-8 grid gap-px bg-white/10 border border-white/10', todayByLoc.length > 1 && 'lg:grid-cols-2']}>
          {todayByLoc.map(({ l, items }) => (
            <div class="bg-ink p-5 sm:p-6">
              <p class="flex items-center gap-2 font-semibold text-ash"><Icon name="map-pin" class="size-4 text-glory" />{tr(l, 'name', lang)}</p>
              <ul class="mt-4 space-y-2">
                {items.map((c, i) => (
                  <li class="reveal group/c flex items-start gap-4 border-l-4 border-white/20 bg-coal px-4 py-3 transition-opacity data-[state=done]:opacity-50 data-[state=live]:border-glory data-[state=live]:bg-glory/10" style={`--i:${i}`} data-class-time={`${c.startTime}-${c.endTime}`}>
                    <span class="w-32 shrink-0 font-display text-2xl leading-[1.12] tracking-wide">{c.startTime}<span class="text-ash">–{c.endTime}</span></span>
                    <span class="min-w-0">
                      <!-- Tên lớp + huy hiệu cùng một hàng, căn giữa theo chiều dọc (không lệch lên trên như align-middle). -->
                      <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
                        <span class="font-display text-2xl uppercase leading-[1.12] tracking-wide">{tr(c, 'name', lang)}</span>
                        <span class="hidden items-center gap-1.5 bg-glory px-2 py-1 font-display text-xs leading-none tracking-widest text-white group-data-[state=live]/c:inline-flex">
                          <span class="size-2 animate-pulse rounded-full bg-white motion-reduce:animate-none" aria-hidden="true"></span>{t(lang, 'today_live')}
                        </span>
                      </span>
                      {coachName(c.coachId) && <span class="mt-0.5 block text-sm text-ash">{coachName(c.coachId)}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
  </section>

  <!-- MÔN HỌC -->
  <section class="border-t border-white/10 py-16 sm:py-24">
    <div class="container-x">
      <div class="grid gap-4 lg:grid-cols-2 lg:items-end">
        <h2 class="text-6xl sm:text-8xl">{t(lang, 'disciplines_title')}</h2>
        <p class="text-lg text-white/75 lg:text-right">{t(lang, 'disciplines_sub')}</p>
      </div>
      <div class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {disciplines.map((d, i) => (
          <a href={href(`/mon-hoc/${d.slug}`, lang)} class:list={['reveal group relative isolate overflow-hidden p-6 sm:p-9 min-h-56 sm:min-h-80 flex flex-col border border-white/15 focus-visible:outline-2 focus-visible:outline-glory transition-colors duration-300', i === 0 ? 'bg-glory text-white sm:col-span-2 lg:col-span-2 hover:bg-glory-dark' : 'bg-coal hover:bg-white/10']} style={`--i:${i}`}>
            {i === 0 && <span class="pointer-events-none absolute -right-4 top-0 font-display text-[12rem] leading-none text-white/10 sm:text-[20rem]" aria-hidden="true">MMA</span>}
            <span class:list={['h-1 w-12', i === 0 ? 'bg-white' : 'bg-glory']} aria-hidden="true"></span>
            <h3 class:list={['relative mt-auto pt-8 text-3xl sm:text-5xl leading-[1.12]', i === 0 && 'sm:text-7xl']}>{tr(d, 'name', lang)}</h3>
            <p class:list={['relative mt-3 hidden max-w-lg line-clamp-3 sm:block', i === 0 ? 'text-white/90' : 'text-white/75']}>{tr(d, 'summary', lang)}</p>
            <Icon name="arrow-up-right" class="absolute right-5 top-5 size-7 text-white transition-transform duration-200 group-hover:translate-x-1 group-hover:-translate-y-1" />
          </a>
        ))}
        <a href={href('/dang-ky-hoc-thu', lang)} class="reveal group relative overflow-hidden bg-bone text-ink p-6 sm:p-9 min-h-48 sm:min-h-80 flex flex-col justify-between hover:bg-white focus-visible:outline-2 focus-visible:outline-glory" style={`--i:${disciplines.length}`}>
          <Icon name="arrow-up-right" class="size-8 sm:size-10 text-glory transition-transform duration-300 group-hover:translate-x-1.5 group-hover:-translate-y-1.5 group-hover:scale-110" />
          <span class="font-display text-2xl sm:text-5xl uppercase leading-[1.12]">{t(lang, 'cta_trial')}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- FIGHTERS OF GLORY -->
  <section class="relative bg-bone text-ink py-16 sm:py-24 overflow-hidden">
    <span class="drift-x pointer-events-none absolute -top-6 right-0 font-display text-[22vw] leading-none text-ink/[0.05] select-none" aria-hidden="true">GLORY</span>
    <div class="container-x relative">
      <p class="eyebrow !text-glory-dark">{t(lang, 'coaches_label')}</p>
      <h2 class="mt-2 text-6xl sm:text-8xl">{t(lang, 'coaches_title')}</h2>
      <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
        <p class="text-lg text-ink/75">{t(lang, 'coaches_sub')}</p>
        {homeCoaches.length < coaches.length && <a href={href('/huan-luyen-vien', lang)} class="inline-flex min-h-11 items-center gap-2 font-display uppercase tracking-wider text-ink hover:text-glory-dark">{t(lang, 'cta_all')}<Icon name="arrow-right" /></a>}
      </div>
      <div class:list={['mt-12 -mx-4 px-4 sm:mx-0 sm:px-0 flex gap-5 overflow-x-auto snap-x snap-mandatory pb-6 lg:grid lg:overflow-visible', homeCoaches.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
        {homeCoaches.map((c, i) => <CoachCard coach={c} lang={lang} i={i} tone="light" class="snap-start shrink-0 w-[64%] sm:w-80 lg:w-auto" />)}
      </div>
    </div>
  </section>

  <!-- THÀNH TÍCH -->
  {achievements.length > 0 && (
    <section class="bg-ink py-16 sm:py-20 border-b border-white/10">
      <div class="container-x">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="text-5xl sm:text-7xl">{t(lang, 'achievements_title')}</h2>
          <a href={href('/thanh-tich', lang)} class="inline-flex min-h-11 items-center gap-2 font-display uppercase tracking-wider hover:text-glory">{t(lang, 'cta_all')}<Icon name="arrow-right" /></a>
        </div>
        <ul class="mt-10 grid gap-px bg-white/10 border border-white/10 sm:grid-cols-2 lg:grid-cols-4">
          {[...achievements].sort((x, y) => Number(!!y.imageKey) - Number(!!x.imageKey)).slice(0, 4).map((a, i) => (
            <li class="reveal bg-ink p-6" style={`--i:${i}`}>
              {a.imageKey
                ? <a href={mediaUrl(a.imageKey)} data-lightbox="home-achievements" data-caption={tr(a, 'title', lang)} class="group -mx-6 -mt-6 mb-5 block aspect-[4/3] overflow-hidden"><img src={thumbUrl(a.imageKey)} srcset={thumbSrcset(a.imageKey)} sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 25vw" alt={tr(a, 'title', lang)} loading="lazy" class="size-full object-cover" data-zoom /></a>
                : <AchievementIcon line={tr(a, 'title', lang)} class="size-10" />}
              <p class="mt-4 font-display text-3xl uppercase leading-tight">{tr(a, 'title', lang)}</p>
              {a.eventName && <p class="mt-2 text-white/75">{a.eventName}</p>}
              {coachName(a.coachId) && <p class="mt-1 text-sm text-ash">{coachName(a.coachId)}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Dải chữ viền các môn, chạy ngược chiều dải slogan -->
  <Marquee text={disciplines.map((d) => tr(d, 'name', lang)).join(' · ')} class="border-y border-white/10 bg-ink text-white" outline reverse />

  <!-- HỌC PHÍ -->
  <section class="container-x py-16 sm:py-24">
    <div class="grid gap-4 lg:grid-cols-2 lg:items-end">
      <h2 class="text-6xl sm:text-8xl">{t(lang, 'fees_title')}</h2>
      <div class="lg:text-right">
        <p class="text-lg text-white/75">{t(lang, 'fees_sub')}</p>
        <a href={href('/hoc-phi', lang)} class="mt-2 inline-flex min-h-11 items-center gap-2 font-display uppercase tracking-wider hover:text-glory">{t(lang, 'cta_all')}<Icon name="arrow-right" /></a>
      </div>
    </div>
    <!-- Thẻ gọn (không danh sách quyền lợi): 4 gói đầy đủ trên điện thoại dài ~2.800px; chi tiết ở trang Học phí. -->
    <div class="mt-12 grid gap-x-4 gap-y-8 sm:grid-cols-2 sm:gap-x-6 lg:grid-cols-4">
      {plans.map((p) => <PlanCard plan={p} lang={lang} compact />)}
    </div>
    <div class="mt-10 flex flex-col gap-4 border-2 border-white/15 p-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-display text-3xl uppercase">{t(lang, 'open_mat_name')} <span class="text-glory italic">{t(lang, 'free')}</span></p>
      <p class="flex items-center gap-2 font-display text-2xl tracking-wide"><Icon name="calendar" class="size-6 text-glory" />{t(lang, 'open_mat_time')}</p>
    </div>
  </section>

  <!-- TIN TỨC -->
  {posts.length > 0 && (
    <section class="border-t border-white/10 py-16 sm:py-24">
      <div class="container-x">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 class="text-5xl sm:text-7xl">{t(lang, 'news_title')}</h2>
            <p class="mt-2 text-white/75">{t(lang, 'news_sub')}</p>
          </div>
          <a href={href('/nhat-ky', lang)} class="inline-flex min-h-11 items-center gap-2 font-display uppercase tracking-wider hover:text-glory">{t(lang, 'cta_all')}<Icon name="arrow-right" /></a>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3 items-start">
          {posts.map((p, i) => <PostCard post={p} lang={lang} i={i} />)}
        </div>
      </div>
    </section>
  )}

  <!-- CẢM NHẬN -->
  {testimonials.length > 0 && (
    <section class="bg-coal py-16 sm:py-24">
      <div class="container-x flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-5xl sm:text-7xl">{t(lang, 'testimonials_title')}</h2>
        <a href={href('/cam-nhan', lang)} class="inline-flex min-h-11 items-center gap-2 font-display uppercase tracking-wider hover:text-glory">{t(lang, 'cta_all')}<Icon name="arrow-right" /></a>
      </div>
      <div class="mt-10"><TestimonialBand items={testimonials} lang={lang} tone="ink" /></div>
    </section>
  )}

  <!-- CƠ SỞ -->
  <section class="container-x py-16 sm:py-24">
    <h2 class="text-5xl sm:text-7xl">{t(lang, 'locations_title')}</h2>
    <div class="mt-10 grid gap-px bg-white/10 border border-white/10 md:grid-cols-2">
      {locations.map((l, i) => (
        <div class="reveal relative overflow-hidden bg-ink p-7 sm:p-10" style={`--i:${i}`} data-tilt>
          <p class="eyebrow">{tr(l, 'name', lang)}</p>
          <p class="relative mt-4 max-w-sm text-lg leading-relaxed">{l.address}</p>
          <div class="relative mt-6 flex flex-wrap gap-3">
            {l.mapUrl && <a href={l.mapUrl} target="_blank" rel="noopener" class="btn-ghost !text-base"><Icon name="map-pin" />{t(lang, 'directions')}</a>}
            {classes.some((c) => c.locationId === l.id) || l.scheduleImageKey
              ? <a href={`${href('/lich-hoc', lang)}?co-so=${l.id}`} class="btn !text-base border-2 border-white/20 hover:border-glory hover:text-glory"><Icon name="calendar" />{t(lang, 'nav_schedule')}</a>
              : <a href={`https://zalo.me/${club.zalo}`} target="_blank" rel="noopener" class="btn !text-base border-2 border-white/20 hover:border-glory hover:text-glory"><Icon name="message" />{t(lang, 'ask_schedule')}</a>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <CtaBand lang={lang} />
</PublicLayout>
