---
import PublicLayout from '../layouts/PublicLayout.astro';
import PageHero from '../components/public/PageHero.astro';
import Icon from '../components/public/Icon.astro';
import CtaBand from '../components/public/CtaBand.astro';
import { publicTestimonials } from '../lib/public';
import { mediaUrl } from '../lib/site';
import { t, tr, type Lang } from '../i18n';

const lang: Lang = Astro.locals.lang;
const items = await publicTestimonials();
Astro.response.headers.set('cache-control', 'public, max-age=60');
---
<PublicLayout path="/cam-nhan" title={t(lang, 'testimonials_title')} description={t(lang, 'testimonials_sub')}>
  <PageHero eyebrow={t(lang, 'nav_testimonials')} title={t(lang, 'testimonials_title')} subtitle={t(lang, 'testimonials_sub')} />
  <section class="container-x py-14 sm:py-20">
    {items.length === 0 && <p class="text-white/75">{t(lang, 'testimonials_empty')}</p>}
    <div class="columns-1 gap-6 md:columns-2 lg:columns-3">
      {items.map((x, i) => (
        <figure class="reveal mb-6 break-inside-avoid border-l-4 border-glory bg-coal p-6 sm:p-8" style={`--i:${i % 3}`}>
          <Icon name="quote" filled class="size-9 text-glory/40" />
          <blockquote class="mt-4 text-lg text-white/90 whitespace-pre-line">{tr(x, 'content', lang)}</blockquote>
          <figcaption class="mt-6 flex items-center gap-4">
            {x.photoKey && <img src={mediaUrl(x.photoKey)} alt="" loading="lazy" class="size-12 object-cover grayscale" />}
            <span><span class="block font-display text-2xl uppercase">{x.authorName}</span>{x.authorRole && <span class="text-sm text-ash">{tr(x, 'authorRole', lang)}</span>}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
  <CtaBand lang={lang} />
</PublicLayout>
