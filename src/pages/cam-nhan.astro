---
import PublicLayout from '../layouts/PublicLayout.astro';
import PageHero from '../components/public/PageHero.astro';
import CtaBand from '../components/public/CtaBand.astro';
import TestimonialBand from '../components/public/TestimonialBand.astro';
import { publicTestimonials } from '../lib/public';
import { t as baseT, type Lang } from '../i18n';
const t = (lang: Parameters<typeof baseT>[0], key: Parameters<typeof baseT>[1]) => baseT(lang, key, Astro.locals.site.texts);

const lang: Lang = Astro.locals.lang;
const items = await publicTestimonials();
Astro.response.headers.set('cache-control', 'public, max-age=60');
---
<PublicLayout path="/cam-nhan" title={t(lang, 'testimonials_title')} description={t(lang, 'testimonials_sub')}>
  <PageHero eyebrow={t(lang, 'nav_testimonials')} title={t(lang, 'testimonials_title')} subtitle={t(lang, 'testimonials_sub')} />
  <!-- Keep testimonials in one scrollable row with navigation controls. -->
  <section class="py-14 sm:py-20">
    {items.length === 0
      ? <p class="container-x text-white/75">{t(lang, 'testimonials_empty')}</p>
      : <TestimonialBand items={items} lang={lang} />}
  </section>
  <CtaBand lang={lang} />
</PublicLayout>
