---
import PublicLayout from '../../layouts/PublicLayout.astro';
import PostCard from '../../components/public/PostCard.astro';
import Icon from '../../components/public/Icon.astro';
import CtaBand from '../../components/public/CtaBand.astro';
import { postBySlug, publishedPosts } from '../../lib/public';
import { toText } from '../../lib/html';
import { youtubeId } from '../../lib/util';
import { mediaUrl } from '../../lib/site';
import { t, tr, href, type Lang } from '../../i18n';

const lang: Lang = Astro.locals.lang;
const post = await postBySlug(Astro.params.slug ?? '');
if (!post) return Astro.rewrite('/404');
const latest = (await publishedPosts(4)).filter((p) => p.id !== post.id).slice(0, 3);
const raw = tr(post, 'content', lang);
const body = post.format === 'html' ? toText(raw) : raw;
const title = tr(post, 'title', lang) || body.slice(0, 60) || t(lang, 'news_title');
// Use the first image or YouTube cover when sharing the post.
const cover = post.media.find((m) => m.type !== 'video');
const ogImage = !cover ? null : cover.type === 'image' ? mediaUrl(cover.key) : `https://i.ytimg.com/vi/${youtubeId(cover.key)}/hqdefault.jpg`;
Astro.response.headers.set('cache-control', 'public, max-age=60');
---
<PublicLayout path={`/nhat-ky/${post.slug}`} title={title} description={body.slice(0, 160)} image={ogImage} ogType="article">
  <section class="container-x py-10 sm:py-14">
    <div class="mx-auto max-w-2xl">
      <a href={href('/nhat-ky', lang)} class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-ash hover:text-white"><Icon name="arrow-left" class="size-4" />{t(lang, 'news_title')}</a>
      <div class="mt-4"><PostCard post={post} lang={lang} full /></div>
    </div>
  </section>
  {latest.length > 0 && (
    <section class="container-x pb-16">
      <h2 class="text-4xl">{t(lang, 'news_title')}</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3 items-start">
        {latest.map((p, i) => <PostCard post={p} lang={lang} i={i} />)}
      </div>
    </section>
  )}
  <CtaBand lang={lang} />
</PublicLayout>
