---
import { eq, asc, desc } from 'drizzle-orm';
import PublicLayout from '../layouts/PublicLayout.astro';
import PageHero from '../components/public/PageHero.astro';
import Icon from '../components/public/Icon.astro';
import { db, schema } from '../db';
import { youtubeEmbed } from '../lib/public';
import { thumbSrcset, thumbUrl } from '../lib/site';
import { t, tr, href, type Lang } from '../i18n';

const lang: Lang = Astro.locals.lang;
const all = await db.select().from(schema.galleryItems).where(eq(schema.galleryItems.isPublic, true))
  .orderBy(asc(schema.galleryItems.sort), desc(schema.galleryItems.createdAt));
const albums = [...new Set(all.map((g) => g.album).filter((a): a is string => !!a))];
const album = Astro.url.searchParams.get('album');
const items = album ? all.filter((g) => g.album === album) : all;
const photos = items.filter((g) => g.type === 'photo' && g.key);
const videos = items.filter((g) => g.type === 'video' && g.videoUrl);
const albumLink = (a?: string) => (a ? `${href('/thu-vien', lang)}?album=${encodeURIComponent(a)}` : href('/thu-vien', lang));
Astro.response.headers.set('cache-control', 'public, max-age=60');
---
<PublicLayout path="/thu-vien" title={t(lang, 'gallery_title')} description={t(lang, 'gallery_sub')}>
  <PageHero eyebrow={t(lang, 'eb_gallery')} title={t(lang, 'gallery_title')} subtitle={t(lang, 'gallery_sub')} />
  <section class="container-x py-10">
    {albums.length > 0 && (
      <div class="-mx-4 px-4 flex gap-2 overflow-x-auto pb-2">
        <a href={albumLink()} class:list={['shrink-0 min-h-11 inline-flex items-center px-4 border font-display uppercase tracking-wider text-sm', !album ? 'bg-white text-ink border-white' : 'border-white/20 hover:border-white']}>{t(lang, 'gallery_all')}</a>
        {albums.map((a) => <a href={albumLink(a)} class:list={['shrink-0 min-h-11 inline-flex items-center px-4 border font-display uppercase tracking-wider text-sm', album === a ? 'bg-white text-ink border-white' : 'border-white/20 hover:border-white']}>{a}</a>)}
      </div>
    )}

    {items.length === 0 && (
      <div class="mt-8 border-2 border-dashed border-white/20 p-12 text-center">
        <Icon name="image" class="mx-auto size-12 text-glory" />
        <p class="mt-4 text-lg text-white/80">{t(lang, 'gallery_empty')}</p>
      </div>
    )}

    {photos.length > 0 && (
      <ul class="mt-8 grid grid-cols-2 gap-1 sm:grid-cols-3 lg:grid-cols-4">
        {photos.map((g, i) => (
          <li class:list={['reveal', i % 7 === 0 && 'sm:col-span-2 sm:row-span-2']} style={`--i:${i % 6}`}>
            <button type="button" data-lightbox="gallery" data-src={`/media/${g.key}`} data-caption={tr(g, 'caption', lang)}
              class="group relative block size-full aspect-square overflow-hidden bg-coal" aria-label={tr(g, 'caption', lang) || `${t(lang, 'gallery_title')} ${i + 1}`}>
              <img src={thumbUrl(g.key)!} srcset={thumbSrcset(g.key)} sizes="(max-width: 639px) 50vw, (max-width: 1023px) 50vw, 33vw" alt={tr(g, 'caption', lang)} loading="lazy" class="size-full object-cover transition duration-300 group-hover:scale-105" />
            </button>
          </li>
        ))}
      </ul>
    )}

    {videos.length > 0 && (
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {videos.map((g) => {
          const embed = youtubeEmbed(g.videoUrl);
          return embed ? (
            <figure>
              <div class="aspect-video bg-coal"><iframe src={embed} title={tr(g, 'caption', lang) || 'Video'} loading="lazy" class="size-full" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>
              {tr(g, 'caption', lang) && <figcaption class="mt-2 text-white/80">{tr(g, 'caption', lang)}</figcaption>}
            </figure>
          ) : (
            <a href={g.videoUrl} target="_blank" rel="noopener" class="group flex items-center gap-5 border-2 border-white/15 p-6 hover:border-glory">
              <span class="grid size-14 shrink-0 place-items-center bg-glory"><Icon name="play" filled class="size-6" /></span>
              <span class="min-w-0"><span class="block font-display text-2xl uppercase">{t(lang, 'watch_video')}</span><span class="text-white/75">{tr(g, 'caption', lang)}</span></span>
              <Icon name="external" class="ml-auto size-5 shrink-0" />
            </a>
          );
        })}
      </div>
    )}
  </section>

</PublicLayout>
