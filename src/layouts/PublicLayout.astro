---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/public/Icon.astro';
import { sql } from 'drizzle-orm';
import { db } from '../db';
import { vnNow } from '../lib/util';
import { telHref } from '../lib/site';
import { t as baseT, href, type Lang, type DictKey } from '../i18n';
const t = (lang: Parameters<typeof baseT>[0], key: Parameters<typeof baseT>[1]) => baseT(lang, key, Astro.locals.site.texts);

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  /** Vietnamese path used by the language switcher. */
  path?: string;
  /** Open Graph article type for post pages. */
  ogType?: string;
  noindex?: boolean;
  /** Optional schema.org structured data for the page. */
  jsonLd?: Record<string, unknown>;
}

const lang: Lang = Astro.locals.lang;
const { club, locations } = Astro.locals.site;
const { path = '/', ogType = 'website', noindex = false, jsonLd } = Astro.props;
const title = Astro.props.title ? `${Astro.props.title} | ${club.name}` : `${club.name} — ${club.slogan}`;
const description = Astro.props.description || (lang === 'en' ? club.tagline_en : club.tagline) || club.tagline;
const image = new URL(Astro.props.image ?? '/og-default.png', Astro.site).href;
const canonical = new URL(href(path, lang), Astro.site).href;

// Hide navigation links to sections without content.
// Keep the class diary link visible even before the first post.
const counts = (await db.get<Record<string, number>>(sql`select
  (select count(*) from testimonials where is_public = 1) as "/cam-nhan",
  (select count(*) from faqs where is_public = 1) as "/hoi-dap",
  (select count(*) from gallery_items where is_public = 1) as "/thu-vien",
  (select count(*) from achievements where is_public = 1) as "/thanh-tich",
  (select count(*) from belts b join disciplines d on d.id = b.discipline_id where d.has_belts = 1 and d.is_public = 1) as "/cap-dai"`)) ?? {};
const hasContent = ([p]: [string, DictKey]) => counts[p] !== 0;

const main = ([
  ['/mon-hoc', 'nav_disciplines'],
  ['/lich-hoc', 'nav_schedule'],
  ['/huan-luyen-vien', 'nav_coaches'],
  ['/hoc-phi', 'nav_fees'],
  ['/nhat-ky', 'nav_news'],
  ['/lien-he', 'nav_contact'],
] as [string, DictKey][]).filter(hasContent);
const more = ([
  ['/gioi-thieu', 'nav_about'],
  ['/thanh-tich', 'nav_achievements'],
  ['/cap-dai', 'nav_belts'],
  ['/thu-vien', 'nav_gallery'],
  ['/cam-nhan', 'nav_testimonials'],
  ['/hoi-dap', 'nav_faq'],
] as [string, DictKey][]).filter(hasContent);
const current = (p: string) => path === p || path.startsWith(p + '/');
const otherLang: Lang = lang === 'vi' ? 'en' : 'vi';
const hotline = club.hotlines[0];
const onTrialPage = path === '/dang-ky-hoc-thu';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="vi" href={new URL(href(path, 'vi'), Astro.site).href} />
    <link rel="alternate" hreflang="en" href={new URL(href(path, 'en'), Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(href(path, 'vi'), Astro.site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={club.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Escape less-than signs so CMS text cannot close the script tag. */}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...jsonLd }).replace(/</g, '\\u003c')} />}
  </head>
  <body data-rendered-date={vnNow().date} class="min-h-dvh flex flex-col overflow-x-clip pb-[calc(4rem+env(safe-area-inset-bottom))] lg:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] btn-red">{t(lang, 'skip_to_content')}</a>
    <header id="site-header" class="sticky top-0 z-40 border-b border-white/10 bg-ink/95 data-[scrolled]:shadow-[0_8px_30px_rgb(0_0_0/0.5)]">
      <span class="scroll-progress" aria-hidden="true"></span>
      <div class="container-x flex h-16 items-center justify-between gap-4">
        <a href={href('/', lang)} class="flex min-h-11 min-w-11 items-center gap-3 shrink-0" aria-label={`${club.name} — ${t(lang, 'home')}`}>
          <Logo class="h-10 w-auto text-white" title="" />
          <span class="font-display text-xl tracking-wider leading-[0.9] hidden sm:block" aria-hidden="true">GLORY<br /><span class="text-glory">FIGHT CLUB</span></span>
        </a>
        <nav class="hidden lg:flex items-center gap-7 font-display uppercase tracking-wider" aria-label="Main">
          {main.map(([p, k]) => (
            <a href={href(p, lang)} aria-current={current(p) ? 'page' : undefined}
              class:list={['relative px-1 py-2 transition-colors hover:text-glory', current(p) && 'text-glory after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:bg-glory']}><span class="roll" data-text={t(lang, k)}><span>{t(lang, k)}</span></span></a>
          ))}
        </nav>
        <div class="flex items-center gap-2 sm:gap-3">
          <a href={href(path, otherLang)} hreflang={otherLang} lang={otherLang}
            class="grid min-h-11 min-w-11 place-items-center font-display text-sm tracking-widest text-ash hover:text-white"
            aria-label={otherLang === 'en' ? 'English' : 'Tiếng Việt'}>{otherLang.toUpperCase()}</a>
          <a href={href('/dang-ky-hoc-thu', lang)} class="btn-red !min-h-10 !px-4 !py-2 !text-base hidden sm:inline-flex">{t(lang, 'cta_trial')}</a>
          <details class="lg:hidden group" id="mnav">
            <summary class="grid size-11 place-items-center border border-white/30" aria-label={t(lang, 'menu')}>
              <Icon name="menu" class="size-6 group-open:hidden" />
              <Icon name="x" class="size-6 hidden group-open:block" />
            </summary>
            <div class="fixed inset-x-0 top-16 bottom-0 overflow-y-auto bg-ink border-t border-white/10">
              <nav class="container-x py-6" aria-label="Mobile">
                <ul class="divide-y divide-white/10 border-y border-white/10">
                  {main.map(([p, k]) => (
                    <li><a href={href(p, lang)} class:list={['flex items-center justify-between py-4 font-display text-4xl uppercase', current(p) ? 'text-glory' : 'hover:text-glory']}>
                      <span>{t(lang, k)}</span><Icon name="arrow-up-right" class="size-6 text-ash" />
                    </a></li>
                  ))}
                </ul>
                <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-1">
                  {more.map(([p, k]) => <li><a href={href(p, lang)} class="block py-2 font-display uppercase tracking-wider text-white/75 hover:text-glory">{t(lang, k)}</a></li>)}
                </ul>
                <a href={href('/dang-ky-hoc-thu', lang)} class="btn-red mt-8 w-full">{t(lang, 'cta_trial')}</a>
                <a href={telHref(hotline)} class="btn-ghost mt-3 w-full"><Icon name="phone" />{hotline}</a>
              </nav>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1"><slot /></main>

    <footer class="relative overflow-hidden bg-coal border-t-4 border-glory">
      <Logo class="absolute -right-20 -bottom-24 h-96 w-auto text-white/[0.03]" title="" />
      <div class="container-x py-14 grid gap-10 md:grid-cols-12">
        <div class="md:col-span-4">
          <Logo class="h-16 w-auto text-white" title="" />
          <p class="display text-4xl mt-5">{club.slogan.split('–').map((part, i) => <span class:list={['block', i > 0 && 'text-glory']}>{part.trim()}</span>)}</p>
          <div class="mt-6 flex gap-2">
            {club.facebook && <a href={club.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="grid size-11 place-items-center border border-white/20 hover:bg-glory hover:border-glory transition-colors"><Icon name="facebook" /></a>}
            {club.instagram && <a href={club.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="grid size-11 place-items-center border border-white/20 hover:bg-glory hover:border-glory transition-colors"><Icon name="instagram" /></a>}
            <a href={`https://zalo.me/${club.zalo}`} target="_blank" rel="noopener" aria-label="Zalo" class="grid size-11 place-items-center border border-white/20 hover:bg-glory hover:border-glory transition-colors font-display text-xs">Zalo</a>
          </div>
        </div>
        <!-- Keep links at least 44px tall on phones. -->
        <nav class="md:col-span-3 grid grid-cols-2 gap-x-4 content-start md:gap-y-2" aria-label="Footer">
          {[...main, ...more].map(([p, k]) => <a href={href(p, lang)} class="flex min-h-11 items-center text-white/75 hover:text-glory md:min-h-0 md:py-1">{t(lang, k)}</a>)}
          {Astro.locals.site.policy && <a href={href('/quy-dinh', lang)} class="flex min-h-11 items-center text-white/75 hover:text-glory md:min-h-0 md:py-1">{t(lang, 'policy_title')}</a>}
        </nav>
        <div class="md:col-span-5 grid gap-6 sm:grid-cols-2">
          {locations.map((l) => (
            <div>
              <p class="eyebrow">{lang === 'en' ? (l.nameEn || l.name) : l.name}</p>
              <p class="mt-2 text-sm text-white/80">{l.address}</p>
              {l.mapUrl && <a href={l.mapUrl} target="_blank" rel="noopener" class="mt-2 inline-flex items-center gap-1 min-h-11 text-sm font-semibold hover:text-glory"><Icon name="map-pin" class="size-4" />{t(lang, 'directions')}</a>}
            </div>
          ))}
          <div class="sm:col-span-2">
            <p class="eyebrow">{t(lang, 'hotline')}</p>
            <div class="mt-2 flex flex-wrap gap-x-6">
              {club.hotlines.map((p) => <a href={telHref(p)} class="font-display text-2xl tracking-wide min-h-11 inline-flex items-center hover:text-glory">{p}</a>)}
            </div>
          </div>
        </div>
      </div>
      <div class="container-x pb-8 text-sm text-ash">© {new Date().getFullYear()} {club.name}. {t(lang, 'footer_rights')}</div>
    </footer>

    <!-- Group full-size images for swipe and arrow navigation. -->
    <dialog id="lightbox" class="m-0 h-dvh max-h-none w-screen max-w-none bg-ink/95 p-0 text-white backdrop:bg-black/80" aria-label={t(lang, 'gallery_title')}>
      <div class="relative grid h-full place-items-center p-4 sm:p-12">
        <img id="lb-img" alt="" class="max-h-[85dvh] max-w-full object-contain transition-opacity duration-200" />
        <p class="absolute inset-x-4 bottom-4 text-center text-white/85"><span id="lb-cap"></span> <span id="lb-count" class="ml-2 font-display tracking-wider text-ash"></span></p>
        <button type="button" data-lb="close" class="absolute right-3 top-3 grid size-12 place-items-center bg-white/10 hover:bg-glory" aria-label={t(lang, 'close')}><Icon name="x" /></button>
        <button type="button" data-lb="prev" class="absolute left-3 top-1/2 grid size-12 -translate-y-1/2 place-items-center bg-white/10 hover:bg-glory" aria-label={t(lang, 'prev')}><Icon name="chevron-left" /></button>
        <button type="button" data-lb="next" class="absolute right-3 top-1/2 grid size-12 -translate-y-1/2 place-items-center bg-white/10 hover:bg-glory" aria-label={t(lang, 'next')}><Icon name="chevron-right" /></button>
      </div>
    </dialog>

    <!-- The mobile action bar uses bottom padding to avoid hiding page content. -->
    <nav class:list={['fixed inset-x-0 bottom-0 z-30 grid border-t border-white/10 bg-ink/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md lg:hidden', onTrialPage ? 'grid-cols-2' : 'grid-cols-[1fr_1fr_1.4fr]']} aria-label={t(lang, 'cta_call')}>
      <a href={telHref(hotline)} class="flex min-h-16 flex-col items-center justify-center gap-1 text-xs font-semibold text-white/90 active:bg-white/10">
        <Icon name="phone" class="size-5 text-glory" />{t(lang, 'cta_call')}
      </a>
      <a href={`https://zalo.me/${club.zalo}`} target="_blank" rel="noopener" class="flex min-h-16 flex-col items-center justify-center gap-1 border-x border-white/10 text-xs font-semibold text-white/90 active:bg-white/10">
        <span class="grid size-5 place-items-center rounded-full bg-[#0068ff] text-[9px] font-bold leading-none text-white" aria-hidden="true">Z</span>Zalo
      </a>
      {!onTrialPage && (
      <a href={href('/dang-ky-hoc-thu', lang)} class="flex min-h-16 items-center justify-center gap-2 bg-glory px-3 font-display text-lg uppercase tracking-wider text-white active:bg-glory-dark">
        {t(lang, 'trial_title')}<Icon name="arrow-right" class="size-4" />
      </a>
      )}
    </nav>

    <!-- Floating desktop call and Zalo actions. -->
    <div class="fixed right-6 bottom-6 z-30 hidden flex-col gap-3 lg:flex">
      <a href={`https://zalo.me/${club.zalo}`} target="_blank" rel="noopener" aria-label="Zalo"
        class="grid size-14 place-items-center rounded-full bg-[#0068ff] font-display text-white shadow-lg shadow-black/50 transition-transform duration-200 hover:scale-110">Zalo</a>
      <a href={telHref(hotline)} aria-label={`${t(lang, 'cta_call')} ${hotline}`}
        class="relative grid size-14 place-items-center rounded-full bg-glory text-white shadow-lg shadow-black/50 transition-transform duration-200 hover:scale-110">
        <span class="absolute inset-0 rounded-full bg-glory animate-ping opacity-30 motion-reduce:hidden"></span>
        <Icon name="phone" class="relative size-6" />
      </a>
    </div>

    <script>
      // Public reveals, count-ups, header, mobile menu, tilt, and magnetic buttons.
      import '../scripts/motion';

      // Without JavaScript, links still open full-size images.
      const lb = document.getElementById('lightbox') as HTMLDialogElement;
      const lbImg = document.getElementById('lb-img') as HTMLImageElement;
      const lbCap = document.getElementById('lb-cap')!;
      const lbCount = document.getElementById('lb-count')!;
      let group: HTMLElement[] = [];
      let cur = 0;
      let opener: HTMLElement | null = null;
      const show = (i: number) => {
        cur = (i + group.length) % group.length;
        const el = group[cur];
        lbImg.src = el.dataset.src ?? (el as HTMLAnchorElement).href;
        lbImg.alt = lbCap.textContent = el.dataset.caption ?? '';
        lbCount.textContent = group.length > 1 ? `${cur + 1} / ${group.length}` : '';
        lb.querySelectorAll<HTMLElement>('[data-lb=prev],[data-lb=next]').forEach((b) => { b.hidden = group.length < 2; });
      };
      document.addEventListener('click', (e) => {
        const el = (e.target as Element).closest<HTMLElement>('[data-lightbox]');
        if (!el || (e as MouseEvent).ctrlKey || (e as MouseEvent).metaKey) return;
        e.preventDefault();
        group = [...document.querySelectorAll<HTMLElement>(`[data-lightbox="${el.dataset.lightbox}"]`)];
        opener = el;
        show(group.indexOf(el));
        lb.showModal();
      });
      lb.addEventListener('click', (e) => {
        const act = (e.target as HTMLElement).closest<HTMLElement>('[data-lb]')?.dataset.lb;
        if (act === 'close' || e.target === lb || e.target === lbImg.parentElement) lb.close();
        if (act === 'prev') show(cur - 1);
        if (act === 'next') show(cur + 1);
      });
      lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(cur - 1); if (e.key === 'ArrowRight') show(cur + 1); });
      let touchX = 0;
      lb.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
      lb.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - touchX; if (Math.abs(dx) > 50 && group.length > 1) show(cur + (dx < 0 ? 1 : -1)); });
      lb.addEventListener('close', () => { lbImg.removeAttribute('src'); opener?.focus(); });

      // Compute the live class in Vietnam time on the client because pages are cached.
      const hhmm = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Ho_Chi_Minh', hour: '2-digit', minute: '2-digit', hour12: false });
      const day = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Ho_Chi_Minh', year: 'numeric', month: '2-digit', day: '2-digit' });
      const loadedDay = document.body.dataset.renderedDate;
      const markLive = () => {
        if (day.format(new Date()) !== loadedDay) {
          const url = new URL(location.href);
          url.searchParams.set('ngay', day.format(new Date()));
          location.replace(url);
          return;
        }
        const now = hhmm.format(new Date());
        document.querySelectorAll<HTMLElement>('[data-class-time]').forEach((el) => {
          const [start, end] = el.dataset.classTime!.split('-');
          el.dataset.state = now >= end ? 'done' : now >= start ? 'live' : 'next';
        });
      };
      markLive();
      setInterval(markLive, 60_000);
    </script>
  </body>
</html>
