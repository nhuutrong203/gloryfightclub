{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gloryfightclub",
  // Tài khoản Cloudflare (coftivenist@gmail.com) — không bí mật; cần cho deploy tự động từ GitHub.
  "account_id": "f98648b45817ea1db6836671f8bd969a",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_HOST": "gloryfightclub.huutrong203.id.vn",
    "CMS_HOST": "cms-gloryfightclub.huutrong203.id.vn"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glory-db",
      "database_id": "abdfce93-2cee-4e7a-8388-ee3850d794bc",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "glory-media" }],
  // Giới hạn đăng nhập: 10 lần / 60 giây / IP (Workers Rate Limiting).
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // Hai tên miền con trỏ vào cùng Worker; middleware phân luồng public / CMS.
  "routes": [
    { "pattern": "gloryfightclub.huutrong203.id.vn", "custom_domain": true },
    { "pattern": "cms-gloryfightclub.huutrong203.id.vn", "custom_domain": true }
  ],

  // `npm run dev:remote` (CLOUDFLARE_ENV=remote): chạy local nhưng đọc/ghi D1 + R2 THẬT trên cloud.
  // Binding không được kế thừa giữa các env nên phải khai báo lại ở đây.
  "env": {
    "remote": {
      "vars": {
        "PUBLIC_HOST": "gloryfightclub.huutrong203.id.vn",
        "CMS_HOST": "cms-gloryfightclub.huutrong203.id.vn"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "glory-db",
          "database_id": "abdfce93-2cee-4e7a-8388-ee3850d794bc",
          "migrations_dir": "migrations",
          "remote": true
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "glory-media", "remote": true }],
      "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
    }
  }
}
