{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gloryfightclub",
  // Public Cloudflare account ID used by GitHub Actions.
  "account_id": "a0f441c17cd276cee70894a4abcde80d",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_HOST": "gloryfightclub.vn",
    "CMS_HOST": "cms.gloryfightclub.vn"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glory-db",
      "database_id": "28f0d090-4285-4b66-a125-5bc0cb6f4c46",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "glory-media" }],
  // Limit logins to 10 attempts per 60 seconds per IP.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "TRIAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  // Route the public and CMS hostnames through the same Worker.
  "routes": [
    { "pattern": "gloryfightclub.vn", "custom_domain": true },
    { "pattern": "cms.gloryfightclub.vn", "custom_domain": true }
  ],

  // Remote development reads and writes the live D1 database and R2 bucket.
  // Redeclare bindings because environments do not inherit them.
  "env": {
    "remote": {
      "vars": {
        "PUBLIC_HOST": "gloryfightclub.vn",
        "CMS_HOST": "cms.gloryfightclub.vn"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "glory-db",
          "database_id": "28f0d090-4285-4b66-a125-5bc0cb6f4c46",
          "migrations_dir": "migrations",
          "remote": true
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "glory-media", "remote": true }],
      "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "TRIAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ]
    }
  }
}
