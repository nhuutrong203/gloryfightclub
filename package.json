{
  "name": "gloryfightclub",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:remote": "cross-env CLOUDFLARE_ENV=remote astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check",
    "test": "node --test \"tests/*.test.mjs\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply glory-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply glory-db --remote",
    "db:seed": "wrangler d1 execute glory-db --local --file=seed/seed.sql && wrangler d1 execute glory-db --local --file=seed/sample.sql",
    "db:seed:remote": "wrangler d1 execute glory-db --remote --file=seed/seed.sql",
    "db:reset": "node scripts/clear-local-db.mjs && npm run db:migrate && npm run db:seed",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/react": "^7.1.2",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "9.3.12",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "wrangler": "^4.156.1"
  }
}
